# Laravel-specific directories
/vendor
/node_modules

# Public directory
/public/hot
/public/storage
/public/build

# Storage directories
/storage/*.key
/storage/logs
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views

# Ensure critical storage directories are kept
!storage/logs/.gitignore
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore

# Bootstrap cache
/bootstrap/cache

# Ensure bootstrap cache directory is kept
!bootstrap/cache/.gitignore

# Environment files
.env
.env.*
*.env

# PHPUnit and testing
.phpunit.result.cache
/.phpunit.cache

# IDE and OS-specific files
/.idea
/.vscode
/.fleet
.DS_Store
Thumbs.db

# Debug and temporary files
npm-debug.log
yarn-error.log
*.log
*.swp

# Other system files
Homestead.json
Homestead.yaml
auth.json
