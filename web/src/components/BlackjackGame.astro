---
interface Props { framed?: boolean; }
const { framed = false } = Astro.props;
---

<section class:list={['blackjack-game', { framed }]} id="blackjack" data-blackjack-game>
  <div class="blackjack-shell">
    {!framed && <header class="blackjack-header">
      <div>
        <p class="blackjack-kicker">Training room · blackjack</p>
        <h2>Blackjack strategy table</h2>
        <p>Play the hand, read the coach and learn when to hit, stand, double or split.</p>
      </div>
      <div class="blackjack-wallet" aria-label="Practice chip balance">
        <span class="blackjack-chip" aria-hidden="true"></span>
        <strong data-blackjack-balance>2,000</strong>
        <small>chips</small>
      </div>
    </header>}

    <div class="blackjack-table">
      <div class="dealer-zone hand-zone">
        <div class="hand-heading">
          <div><span>Dealer</span><strong data-dealer-score>–</strong></div>
          <small>Stands on all 17</small>
        </div>
        <div class="card-row dealer-cards" data-dealer-cards aria-label="Dealer cards">
          <p class="empty-hand">Dealer cards appear here.</p>
        </div>
      </div>

      <div class="table-rule" aria-hidden="true">
        <span>Blackjack pays 3:2</span><i></i><span>Dealer stands on 17</span>
      </div>

      <div class="player-zone">
        <div class="player-hands" data-player-hands>
          <div class="hand-zone player-hand is-active" data-empty-hand-zone>
            <div class="hand-heading"><div><span>Your hand</span><strong>–</strong></div><small>Choose a bet below to begin</small></div>
            <div class="card-row"><p class="empty-hand">Your cards appear here.</p></div>
          </div>
        </div>
      </div>

      <div class="blackjack-bet-spot" data-blackjack-bet-spot data-state="open" role="status" aria-live="polite">
        <span class="table-bet-chip" data-blackjack-bet-chip aria-hidden="true">20</span>
        <span class="bet-spot-copy"><small>Your bet</small><strong data-blackjack-bet-display>20</strong><em>chips</em></span>
      </div>
    </div>

    <div class="blackjack-game-rail">
      <section class="blackjack-betting-dock" data-blackjack-betting-dock aria-labelledby="blackjack-bet-title">
        <div class="bet-step" id="blackjack-bet-title"><span>1</span><div><strong>Choose your bet</strong><small>Tap a chip to place it on the table</small></div></div>
        <div class="blackjack-stakes" aria-label="Choose your blackjack bet">
          {[10, 20, 50, 100, 500].map((value) => (
            <button type="button" class:list={['blackjack-stake', { selected: value === 20 }]} data-blackjack-stake={value} aria-pressed={value === 20 ? 'true' : 'false'} aria-label={`Bet ${value} chips`}>{value}</button>
          ))}
        </div>
        <div class="bet-balance"><small>Available after bet</small><strong><span data-blackjack-available>1,980</span> chips</strong></div>
        <button type="button" class="deal-button" data-blackjack-deal aria-label="Bet 20 chips and deal cards"><span>2</span><strong data-blackjack-deal-label>Bet 20 & deal</strong></button>
      </section>

      <section class="blackjack-play-dock" data-blackjack-play-dock hidden aria-label="Blackjack actions">
        <div class="play-actions">
          <button type="button" data-blackjack-action="hit" disabled>Hit</button>
          <button type="button" data-blackjack-action="stand" disabled>Stand</button>
          <button type="button" data-blackjack-action="double" disabled>Double</button>
          <button type="button" data-blackjack-action="split" disabled>Split</button>
        </div>
      </section>

      <aside class="coach-panel" data-coach-panel>
        <span class="coach-label">Strategy coach</span>
        <div><strong data-coach-title>Ready for the first hand</strong><p data-coach-copy>The coach uses a standard multi-deck table where the dealer stands on soft 17.</p></div>
        <small data-coach-feedback></small>
      </aside>
    </div>

    <p class="blackjack-status" data-blackjack-status aria-live="polite">Choose a bet, then deal the cards.</p>

    <div class="blackjack-dashboard">
      <div><span>Blackjack hands</span><strong data-blackjack-rounds>0</strong></div>
      <div><span>Profitable hands</span><strong data-blackjack-wins>0</strong></div>
      <div><span>Return rate</span><strong data-blackjack-return>–</strong></div>
      <div class="blackjack-history"><span>Recent hands</span><ol data-blackjack-history><li>No hands played yet.</li></ol></div>
    </div>

    {!framed && <footer class="blackjack-footer">
      <p>Practice only · no insurance or surrender · one split maximum · chips have no monetary value.</p>
      <button type="button" data-blackjack-bonus>Claim +500 daily</button>
    </footer>}
  </div>
</section>

<script>
  import { animate } from 'motion/mini';
  import {
    blackjackCardLabel,
    blackjackCardPath,
    blackjackHandValue,
    canSplitBlackjackHand,
    dealerShouldHit,
    recommendedBlackjackAction,
    settleBlackjackHand,
    shuffledBlackjackShoe,
    type BlackjackAction,
    type BlackjackCard,
  } from '@/lib/blackjack';
  import {
    canClaimTrainingBonus,
    claimTrainingBonus,
    completeTrainingRound,
    readTrainingWallet,
    TRAINING_DAILY_BONUS,
    TRAINING_WALLET_EVENT,
    type TrainingWallet,
  } from '@/lib/training-wallet';

  type Phase = 'betting' | 'dealing' | 'player' | 'dealer' | 'complete';
  type PlayerHand = {
    uiId: string;
    cards: BlackjackCard[];
    stake: number;
    done: boolean;
    fromSplit: boolean;
  };

  const actionLabels: Record<BlackjackAction, string> = {
    hit: 'Hit',
    stand: 'Stand',
    double: 'Double',
    split: 'Split',
  };
  const numberFormat = new Intl.NumberFormat('en-US');
  const wait = (milliseconds: number) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));

  document.querySelectorAll<HTMLElement>('[data-blackjack-game]').forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const dealerCardsRoot = root.querySelector<HTMLElement>('[data-dealer-cards]');
    const dealerScore = root.querySelector<HTMLElement>('[data-dealer-score]');
    const playerHandsRoot = root.querySelector<HTMLElement>('[data-player-hands]');
    const status = root.querySelector<HTMLElement>('[data-blackjack-status]');
    const dealButton = root.querySelector<HTMLButtonElement>('[data-blackjack-deal]');
    const bonusButton = root.querySelector<HTMLButtonElement>('[data-blackjack-bonus]');
    const stakeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-blackjack-stake]')];
    const actionButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-blackjack-action]')];
    const coachTitle = root.querySelector<HTMLElement>('[data-coach-title]');
    const coachCopy = root.querySelector<HTMLElement>('[data-coach-copy]');
    const coachFeedback = root.querySelector<HTMLElement>('[data-coach-feedback]');
    const bettingDock = root.querySelector<HTMLElement>('[data-blackjack-betting-dock]');
    const playDock = root.querySelector<HTMLElement>('[data-blackjack-play-dock]');
    const betSpot = root.querySelector<HTMLElement>('[data-blackjack-bet-spot]');
    const betChip = root.querySelector<HTMLElement>('[data-blackjack-bet-chip]');
    const betDisplays = [...root.querySelectorAll<HTMLElement>('[data-blackjack-bet-display]')];
    const availableDisplay = root.querySelector<HTMLElement>('[data-blackjack-available]');
    const dealLabel = root.querySelector<HTMLElement>('[data-blackjack-deal-label]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let shoe = shuffledBlackjackShoe();
    let dealerCards: BlackjackCard[] = [];
    let playerHands: PlayerHand[] = [];
    let activeHandIndex = 0;
    let selectedStake = 20;
    let phase: Phase = 'betting';
    let revealDealer = false;
    let locked = false;
    let cardSequence = 0;
    let handSequence = 0;
    const cardIds = new WeakMap<BlackjackCard, string>();

    const cardId = (card: BlackjackCard) => {
      const existing = cardIds.get(card);
      if (existing) return existing;
      const id = `blackjack-card-${cardSequence += 1}`;
      cardIds.set(card, id);
      return id;
    };
    const newHandId = () => `blackjack-hand-${handSequence += 1}`;

    const drawCard = () => {
      if (shoe.length < 70) shoe = shuffledBlackjackShoe();
      const card = shoe.pop();
      if (!card) throw new Error('Blackjack shoe is empty.');
      return card;
    };

    const totalStake = () => playerHands.reduce((sum, hand) => sum + hand.stake, 0);
    const activeHand = () => playerHands[activeHandIndex];

    function publishPhase() {
      const busy = phase === 'dealing' || phase === 'dealer';
      root.dataset.phase = phase;
      root.dispatchEvent(new CustomEvent('thecasinos:game-phase', {
        bubbles: true,
        detail: { game: 'blackjack', phase, busy },
      }));
    }

    function setStatus(message: string, tone: 'neutral' | 'success' | 'error' = 'neutral') {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
    }

    function setCardImage(wrapper: HTMLElement, card: BlackjackCard, hidden: boolean) {
      const image = wrapper.querySelector<HTMLImageElement>('img');
      if (!image) return;
      wrapper.classList.toggle('card-back', hidden);
      wrapper.dataset.hidden = String(hidden);
      if (hidden) {
        wrapper.setAttribute('aria-label', 'Face-down dealer card');
        image.src = '/cards/back-cards.png';
        image.alt = '';
      } else {
        wrapper.removeAttribute('aria-label');
        image.src = blackjackCardPath(card);
        image.alt = blackjackCardLabel(card);
      }
    }

    function cardElement(card: BlackjackCard, hidden = false, index = 0) {
      const wrapper = document.createElement('div');
      wrapper.className = 'playing-card';
      wrapper.dataset.cardId = cardId(card);
      wrapper.style.setProperty('--card-index', String(index));
      const image = document.createElement('img');
      image.width = 292;
      image.height = 424;
      image.draggable = false;
      wrapper.append(image);
      setCardImage(wrapper, card, hidden);
      return wrapper;
    }

    async function animateCardIn(wrapper: HTMLElement, origin: 'dealer' | 'player') {
      if (reduceMotion) return;
      const image = wrapper.querySelector<HTMLImageElement>('img');
      if (image) await image.decode().catch(() => undefined);
      animate(
        wrapper,
        {
          opacity: [0, 1],
          transform: origin === 'dealer'
            ? ['translate3d(62px,-46px,0) rotate(5deg) scale(.9)', 'translate3d(0,0,0) rotate(0deg) scale(1)']
            : ['translate3d(-48px,38px,0) rotate(-4deg) scale(.92)', 'translate3d(0,0,0) rotate(0deg) scale(1)'],
        },
        { duration: .34, ease: [0.22, 1, 0.36, 1] },
      );
    }

    async function revealCard(wrapper: HTMLElement, card: BlackjackCard) {
      if (wrapper.dataset.hidden !== 'true') return;
      if (reduceMotion) {
        setCardImage(wrapper, card, false);
        return;
      }
      wrapper.classList.add('is-flipping');
      await animate(wrapper, { transform: ['rotateY(0deg)', 'rotateY(88deg)'] }, { duration: .19, ease: 'easeIn' }).finished;
      setCardImage(wrapper, card, false);
      await animate(wrapper, { transform: ['rotateY(88deg)', 'rotateY(0deg)'] }, { duration: .24, ease: [0.22, 1, 0.36, 1] }).finished;
      wrapper.classList.remove('is-flipping');
    }

    function syncCardRow(row: HTMLElement, cards: BlackjackCard[], hiddenSecond: boolean, origin: 'dealer' | 'player') {
      row.querySelector('.empty-hand')?.remove();
      const previousPositions = new Map<HTMLElement, DOMRect>();
      row.querySelectorAll<HTMLElement>('[data-card-id]').forEach((node) => previousPositions.set(node, node.getBoundingClientRect()));
      const desiredIds = new Set(cards.map(cardId));

      cards.forEach((card, index) => {
        const id = cardId(card);
        let wrapper = [...root.querySelectorAll<HTMLElement>('[data-card-id]')].find((node) => node.dataset.cardId === id);
        const isNew = !wrapper;
        if (!wrapper) wrapper = cardElement(card, hiddenSecond && index === 1, index);
        wrapper.style.setProperty('--card-index', String(index));
        const reference = row.children.item(index);
        if (wrapper.parentElement !== row || reference !== wrapper) row.insertBefore(wrapper, reference || null);
        const shouldHide = hiddenSecond && index === 1;
        if (wrapper.dataset.hidden === 'true' && !shouldHide) void revealCard(wrapper, card);
        else if (wrapper.dataset.hidden !== String(shouldHide)) setCardImage(wrapper, card, shouldHide);
        if (isNew) void animateCardIn(wrapper, origin);
      });

      row.querySelectorAll<HTMLElement>('[data-card-id]').forEach((node) => {
        if (!desiredIds.has(node.dataset.cardId || '')) node.remove();
      });
      if (!cards.length) {
        const empty = document.createElement('p');
        empty.className = 'empty-hand';
        empty.textContent = origin === 'dealer' ? 'Dealer cards appear here.' : 'Your cards appear here.';
        row.append(empty);
      }

      if (!reduceMotion) {
        previousPositions.forEach((before, node) => {
          if (!node.isConnected || node.parentElement !== row) return;
          const after = node.getBoundingClientRect();
          const deltaX = before.left - after.left;
          const deltaY = before.top - after.top;
          if (Math.abs(deltaX) > .5 || Math.abs(deltaY) > .5) {
            animate(node, { transform: [`translate3d(${deltaX}px,${deltaY}px,0)`, 'translate3d(0,0,0)'] }, { duration: .22, ease: [0.22, 1, 0.36, 1] });
          }
        });
      }
    }

    function renderDealer() {
      if (!dealerCardsRoot || !dealerScore) return;
      syncCardRow(dealerCardsRoot, dealerCards, !revealDealer, 'dealer');
      dealerScore.textContent = !dealerCards.length ? '–' : revealDealer
        ? String(blackjackHandValue(dealerCards).total)
        : String(blackjackHandValue([dealerCards[0]]).total);
    }

    function createPlayerHandZone(hand: PlayerHand) {
      const zone = document.createElement('div');
      zone.className = 'hand-zone player-hand';
      zone.dataset.handId = hand.uiId;
      zone.innerHTML = '<div class="hand-heading"><div><span></span><strong></strong></div><small></small></div><div class="card-row"></div>';
      if (!reduceMotion) animate(zone, { opacity: [0, 1], transform: ['scale(.97)', 'scale(1)'] }, { duration: .24, ease: 'easeOut' });
      return zone;
    }

    function renderPlayerHands() {
      if (!playerHandsRoot) return;
      playerHandsRoot.classList.toggle('is-split', playerHands.length > 1);
      if (!playerHands.length) {
        playerHandsRoot.querySelectorAll('[data-hand-id]').forEach((node) => node.remove());
        let placeholder = playerHandsRoot.querySelector<HTMLElement>('[data-empty-hand-zone]');
        if (!placeholder) {
          placeholder = document.createElement('div');
          placeholder.className = 'hand-zone player-hand is-active';
          placeholder.dataset.emptyHandZone = 'true';
          placeholder.innerHTML = '<div class="hand-heading"><div><span>Your hand</span><strong>–</strong></div><small>Choose a bet below to begin</small></div><div class="card-row"><p class="empty-hand">Your cards appear here.</p></div>';
          playerHandsRoot.append(placeholder);
        }
        return;
      }

      playerHandsRoot.querySelector('[data-empty-hand-zone]')?.remove();
      const desiredHands = new Set(playerHands.map((hand) => hand.uiId));

      playerHands.forEach((hand, handIndex) => {
        const value = blackjackHandValue(hand.cards);
        let zone = [...playerHandsRoot.querySelectorAll<HTMLElement>('[data-hand-id]')].find((node) => node.dataset.handId === hand.uiId);
        if (!zone) zone = createPlayerHandZone(hand);
        const reference = playerHandsRoot.children.item(handIndex);
        if (zone.parentElement !== playerHandsRoot || reference !== zone) playerHandsRoot.insertBefore(zone, reference || null);
        zone.classList.toggle('is-active', phase === 'player' && handIndex === activeHandIndex);
        zone.classList.toggle('is-finished', hand.done);
        const title = zone.querySelector<HTMLElement>('.hand-heading span');
        const score = zone.querySelector<HTMLElement>('.hand-heading strong');
        const detail = zone.querySelector<HTMLElement>('.hand-heading small');
        const cards = zone.querySelector<HTMLElement>('.card-row');
        if (!title || !score || !detail || !cards) return;
        title.textContent = playerHands.length > 1 ? `Hand ${handIndex + 1}` : 'Your hand';
        score.textContent = String(value.total);
        detail.textContent = `${numberFormat.format(hand.stake)} chips${value.soft ? ' · soft' : ''}${value.blackjack && !hand.fromSplit ? ' · blackjack' : ''}`;
        syncCardRow(cards, hand.cards, false, 'player');
      });
      playerHandsRoot.querySelectorAll<HTMLElement>('[data-hand-id]').forEach((zone) => {
        if (!desiredHands.has(zone.dataset.handId || '')) zone.remove();
      });
    }

    function actionAvailability() {
      const hand = activeHand();
      const wallet = readTrainingWallet();
      const playing = phase === 'player' && Boolean(hand) && !hand.done && !locked;
      const extraStakeAvailable = playing && totalStake() + hand.stake <= wallet.balance;
      return {
        playing,
        canDouble: Boolean(extraStakeAvailable && hand.cards.length === 2),
        canSplit: Boolean(extraStakeAvailable && playerHands.length === 1 && canSplitBlackjackHand(hand.cards)),
      };
    }

    function renderCoach() {
      actionButtons.forEach((button) => button.classList.remove('is-recommended'));
      if (!coachTitle || !coachCopy) return;
      if (phase !== 'player' || !activeHand() || !dealerCards[0]) {
        coachTitle.textContent = phase === 'complete' ? 'Review the result, then play again'
          : phase === 'dealing' ? 'Cards are being dealt'
            : phase === 'dealer' ? 'Dealer is completing the hand'
              : 'Ready for the first hand';
        coachCopy.textContent = phase === 'complete'
          ? 'Keep the same bet or choose another chip for the next hand.'
          : phase === 'dealing' || phase === 'dealer'
            ? 'The table is locked until the animation is complete.'
            : 'The coach uses a standard multi-deck table where the dealer stands on soft 17.';
        return;
      }
      const availability = actionAvailability();
      const recommendation = recommendedBlackjackAction(activeHand().cards, dealerCards[0], availability);
      coachTitle.textContent = `${actionLabels[recommendation]} is the basic-strategy play`;
      coachCopy.textContent = `Your ${blackjackHandValue(activeHand().cards).total} is compared with the dealer's ${blackjackHandValue([dealerCards[0]]).total}.`;
      root.querySelector<HTMLButtonElement>(`[data-blackjack-action="${recommendation}"]`)?.classList.add('is-recommended');
    }

    function renderBetting() {
      const wallet = readTrainingWallet();
      const committedStake = playerHands.length && (phase === 'player' || phase === 'dealer' || phase === 'dealing')
        ? totalStake()
        : selectedStake;
      const formattedStake = numberFormat.format(committedStake);
      betDisplays.forEach((element) => { element.textContent = formattedStake; });
      if (betChip) betChip.textContent = formattedStake;
      if (availableDisplay) availableDisplay.textContent = numberFormat.format(Math.max(0, wallet.balance - committedStake));
      if (betSpot) betSpot.dataset.state = phase === 'complete' ? 'settled' : phase === 'betting' ? 'open' : 'locked';
      if (bettingDock) bettingDock.hidden = phase === 'player' || phase === 'dealer';
      if (playDock) playDock.hidden = phase !== 'player' && phase !== 'dealer';
      if (dealLabel) {
        dealLabel.textContent = phase === 'dealing' ? 'Dealing…'
          : phase === 'complete' ? `New hand · ${numberFormat.format(selectedStake)} chips`
            : `Bet ${numberFormat.format(selectedStake)} & deal`;
      }
      if (dealButton) dealButton.setAttribute('aria-label', phase === 'complete'
        ? `Start a new hand with a ${selectedStake}-chip bet`
        : `Bet ${selectedStake} chips and deal cards`);
    }

    function renderControls() {
      const wallet = readTrainingWallet();
      const availability = actionAvailability();
      const canChooseStake = (phase === 'betting' || phase === 'complete') && !locked;
      stakeButtons.forEach((button) => { button.disabled = !canChooseStake; });
      actionButtons.forEach((button) => {
        const action = button.dataset.blackjackAction as BlackjackAction;
        button.disabled = !availability.playing
          || (action === 'double' && !availability.canDouble)
          || (action === 'split' && !availability.canSplit);
      });
      if (dealButton) {
        dealButton.disabled = !canChooseStake || selectedStake > wallet.balance;
      }
      renderBetting();
      renderCoach();
      publishPhase();
    }

    function renderWallet(wallet: TrainingWallet = readTrainingWallet()) {
      root.querySelectorAll<HTMLElement>('[data-blackjack-balance]').forEach((element) => {
        element.textContent = numberFormat.format(wallet.balance);
      });
      const stats = wallet.gameStats.blackjack;
      const rounds = root.querySelector<HTMLElement>('[data-blackjack-rounds]');
      const wins = root.querySelector<HTMLElement>('[data-blackjack-wins]');
      const returnRate = root.querySelector<HTMLElement>('[data-blackjack-return]');
      if (rounds) rounds.textContent = numberFormat.format(stats.rounds);
      if (wins) wins.textContent = numberFormat.format(stats.winningRounds);
      if (returnRate) returnRate.textContent = stats.totalWagered > 0 ? `${((stats.totalReturned / stats.totalWagered) * 100).toFixed(1)}%` : '–';
      if (bonusButton) {
        const canClaim = canClaimTrainingBonus(wallet);
        bonusButton.disabled = !canClaim;
        bonusButton.textContent = canClaim ? `Claim +${TRAINING_DAILY_BONUS} daily` : 'Daily bonus claimed';
      }
      const history = root.querySelector<HTMLOListElement>('[data-blackjack-history]');
      if (history) {
        history.replaceChildren();
        const entries = wallet.history.filter((entry) => entry.game === 'blackjack').slice(0, 5);
        if (!entries.length) {
          const empty = document.createElement('li');
          empty.textContent = 'No hands played yet.';
          history.append(empty);
        } else {
          entries.forEach((entry) => {
            const item = document.createElement('li');
            const result = document.createElement('span');
            const net = document.createElement('strong');
            result.textContent = entry.result;
            net.textContent = `${entry.net >= 0 ? '+' : ''}${numberFormat.format(entry.net)}`;
            net.dataset.positive = String(entry.net >= 0);
            item.append(result, net);
            history.append(item);
          });
        }
      }
      renderControls();
    }

    function render() {
      renderDealer();
      renderPlayerHands();
      renderControls();
    }

    function noteDecision(action: BlackjackAction) {
      const availability = actionAvailability();
      const recommendation = recommendedBlackjackAction(activeHand().cards, dealerCards[0], availability);
      if (!coachFeedback) return;
      const correct = action === recommendation;
      coachFeedback.textContent = correct
        ? `Good decision: ${actionLabels[action].toLowerCase()} matches basic strategy.`
        : `You chose ${actionLabels[action].toLowerCase()}; basic strategy preferred ${actionLabels[recommendation].toLowerCase()}.`;
      coachFeedback.dataset.correct = String(correct);
    }

    async function settleRound() {
      locked = true;
      revealDealer = true;
      phase = 'dealer';
      render();
      const hasLiveHand = playerHands.some((hand) => !blackjackHandValue(hand.cards).bust);
      while (hasLiveHand && dealerShouldHit(dealerCards)) {
        await wait(reduceMotion ? 0 : 430);
        dealerCards.push(drawCard());
        renderDealer();
      }
      await wait(reduceMotion ? 0 : 280);

      const settlements = playerHands.map((hand) => settleBlackjackHand(hand.cards, dealerCards, hand.stake, !hand.fromSplit));
      const wagered = totalStake();
      const payout = settlements.reduce((sum, settlement) => sum + settlement.payout, 0);
      const result = settlements.map((settlement, index) => `${playerHands.length > 1 ? `H${index + 1} ` : ''}${settlement.result}`).join(' · ');
      phase = 'complete';
      locked = false;
      const completed = completeTrainingRound({ game: 'blackjack', result, wagered, payout });
      render();
      renderWallet(completed.wallet);
      if (!completed.completed) {
        setStatus('The shared balance changed during this hand. No chips were deducted.', 'error');
        return;
      }
      const net = payout - wagered;
      setStatus(
        net > 0 ? `${numberFormat.format(payout)} chips returned · +${numberFormat.format(net)} net.`
          : net === 0 ? 'Push: your stake was returned.'
            : `${numberFormat.format(Math.abs(net))} chips lost this hand.`,
        net > 0 ? 'success' : 'neutral',
      );
      if (betSpot && !reduceMotion) {
        animate(betSpot, { transform: ['scale(.94)', 'scale(1.04)', 'scale(1)'] }, { duration: .42, ease: 'easeOut' });
      }
    }

    async function moveToNextHand() {
      const nextIndex = playerHands.findIndex((hand, index) => index > activeHandIndex && !hand.done);
      if (nextIndex >= 0) {
        activeHandIndex = nextIndex;
        render();
        setStatus(`Play hand ${activeHandIndex + 1}.`);
        return;
      }
      await settleRound();
    }

    async function dealRound() {
      if (locked || selectedStake > readTrainingWallet().balance) return;
      locked = true;
      phase = 'dealing';
      revealDealer = false;
      dealerCards = [];
      playerHands = [{ uiId: newHandId(), cards: [], stake: selectedStake, done: false, fromSplit: false }];
      activeHandIndex = 0;
      if (coachFeedback) coachFeedback.textContent = '';
      render();
      setStatus('Dealing the cards…');

      for (const target of ['player', 'dealer', 'player', 'dealer'] as const) {
        await wait(reduceMotion ? 0 : 190);
        if (target === 'player') playerHands[0].cards.push(drawCard());
        else dealerCards.push(drawCard());
        render();
      }

      locked = false;
      const playerNatural = blackjackHandValue(playerHands[0].cards).blackjack;
      const dealerNatural = blackjackHandValue(dealerCards).blackjack;
      if (playerNatural || dealerNatural) {
        setStatus(playerNatural ? 'Blackjack.' : 'Dealer blackjack.');
        await settleRound();
        return;
      }
      phase = 'player';
      render();
      setStatus('Choose your action. The recommended play is highlighted.');
    }

    async function playAction(action: BlackjackAction) {
      if (locked || phase !== 'player') return;
      const hand = activeHand();
      if (!hand || hand.done) return;
      const availability = actionAvailability();
      if ((action === 'double' && !availability.canDouble) || (action === 'split' && !availability.canSplit)) return;
      noteDecision(action);

      if (action === 'hit') {
        hand.cards.push(drawCard());
        const value = blackjackHandValue(hand.cards);
        if (value.bust || value.total === 21) hand.done = true;
        render();
        setStatus(value.bust ? `Hand ${activeHandIndex + 1} busts with ${value.total}.` : `Your hand is now ${value.total}.`, value.bust ? 'error' : 'neutral');
        if (hand.done) await moveToNextHand();
        return;
      }

      if (action === 'stand') {
        hand.done = true;
        render();
        setStatus(`Standing on ${blackjackHandValue(hand.cards).total}.`);
        await moveToNextHand();
        return;
      }

      if (action === 'double') {
        hand.stake *= 2;
        hand.cards.push(drawCard());
        hand.done = true;
        render();
        setStatus(`Stake doubled. Final hand: ${blackjackHandValue(hand.cards).total}.`);
        await moveToNextHand();
        return;
      }

      const [first, second] = hand.cards;
      playerHands = [
        { uiId: newHandId(), cards: [first, drawCard()], stake: hand.stake, done: first.rank === 1, fromSplit: true },
        { uiId: newHandId(), cards: [second, drawCard()], stake: hand.stake, done: second.rank === 1, fromSplit: true },
      ];
      activeHandIndex = 0;
      render();
      setStatus(first.rank === 1 ? 'Split aces receive one card each.' : 'Pair split into two hands. Play hand 1.');
      if (first.rank === 1) await settleRound();
    }

    stakeButtons.forEach((button) => button.addEventListener('click', () => {
      selectedStake = Number(button.dataset.blackjackStake || 20);
      stakeButtons.forEach((candidate) => {
        const selected = candidate === button;
        candidate.classList.toggle('selected', selected);
        candidate.setAttribute('aria-pressed', String(selected));
      });
      setStatus(`${numberFormat.format(selectedStake)}-chip bet selected.`);
      renderControls();
      if (!reduceMotion) {
        animate(button, { transform: ['translateY(0) scale(.88)', 'translateY(-3px) scale(1)'] }, { duration: .25, ease: 'easeOut' });
        if (betSpot) animate(betSpot, { transform: ['scale(.94)', 'scale(1.035)', 'scale(1)'] }, { duration: .32, ease: 'easeOut' });
      }
    }));
    actionButtons.forEach((button) => button.addEventListener('click', () => playAction(button.dataset.blackjackAction as BlackjackAction)));
    dealButton?.addEventListener('click', dealRound);
    bonusButton?.addEventListener('click', () => {
      const { claimed, wallet } = claimTrainingBonus();
      renderWallet(wallet);
      setStatus(claimed ? `Daily bonus: +${TRAINING_DAILY_BONUS} chips.` : 'Today’s bonus has already been claimed.', claimed ? 'success' : 'neutral');
    });
    window.addEventListener(TRAINING_WALLET_EVENT, (event) => renderWallet((event as CustomEvent<TrainingWallet>).detail));
    window.addEventListener('storage', () => renderWallet());
    renderWallet();
    render();
  });
</script>

