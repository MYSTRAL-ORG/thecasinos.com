<section class="blackjack-game" id="blackjack" data-blackjack-game>
  <div class="blackjack-shell">
    <header class="blackjack-header">
      <div>
        <p class="blackjack-kicker">Training room · blackjack</p>
        <h2>Blackjack strategy table</h2>
        <p>Play the hand, read the coach and learn when to hit, stand, double or split.</p>
      </div>
      <div class="blackjack-wallet" aria-label="Practice chip balance">
        <span class="blackjack-chip" aria-hidden="true"></span>
        <strong data-blackjack-balance>2,000</strong>
        <small>chips</small>
      </div>
    </header>

    <div class="blackjack-table">
      <div class="dealer-zone hand-zone">
        <div class="hand-heading">
          <div><span>Dealer</span><strong data-dealer-score>–</strong></div>
          <small>Stands on all 17</small>
        </div>
        <div class="card-row dealer-cards" data-dealer-cards aria-label="Dealer cards">
          <p class="empty-hand">Dealer cards appear here.</p>
        </div>
      </div>

      <div class="table-rule" aria-hidden="true">
        <span>Blackjack pays 3:2</span><i></i><span>Dealer stands on 17</span>
      </div>

      <div class="player-zone">
        <div class="player-hands" data-player-hands>
          <div class="hand-zone player-hand is-active">
            <div class="hand-heading"><div><span>Your hand</span><strong>–</strong></div><small>Choose a stake to begin</small></div>
            <div class="card-row"><p class="empty-hand">Your cards appear here.</p></div>
          </div>
        </div>
      </div>
    </div>

    <div class="blackjack-controls">
      <div class="stake-panel">
        <span>Stake</span>
        <div class="blackjack-stakes" aria-label="Select blackjack stake">
          {[10, 20, 50, 100, 500].map((value) => (
            <button type="button" class:list={['blackjack-stake', { selected: value === 20 }]} data-blackjack-stake={value} aria-pressed={value === 20 ? 'true' : 'false'}>{value}</button>
          ))}
        </div>
      </div>

      <div class="coach-panel" data-coach-panel>
        <span class="coach-label">Strategy coach</span>
        <strong data-coach-title>Ready for the first hand</strong>
        <p data-coach-copy>The coach uses a standard multi-deck table where the dealer stands on soft 17.</p>
        <small data-coach-feedback></small>
      </div>

      <div class="action-panel">
        <button type="button" class="deal-button" data-blackjack-deal>Deal cards</button>
        <div class="play-actions">
          <button type="button" data-blackjack-action="hit" disabled>Hit</button>
          <button type="button" data-blackjack-action="stand" disabled>Stand</button>
          <button type="button" data-blackjack-action="double" disabled>Double</button>
          <button type="button" data-blackjack-action="split" disabled>Split</button>
        </div>
      </div>
    </div>

    <p class="blackjack-status" data-blackjack-status aria-live="polite">Select a stake, then deal the cards.</p>

    <div class="blackjack-dashboard">
      <div><span>Blackjack hands</span><strong data-blackjack-rounds>0</strong></div>
      <div><span>Profitable hands</span><strong data-blackjack-wins>0</strong></div>
      <div><span>Return rate</span><strong data-blackjack-return>–</strong></div>
      <div class="blackjack-history"><span>Recent hands</span><ol data-blackjack-history><li>No hands played yet.</li></ol></div>
    </div>

    <footer class="blackjack-footer">
      <p>Practice only · no insurance or surrender · one split maximum · chips have no monetary value.</p>
      <button type="button" data-blackjack-bonus>Claim +500 daily</button>
    </footer>
  </div>
</section>

<script>
  import {
    blackjackCardLabel,
    blackjackCardPath,
    blackjackHandValue,
    canSplitBlackjackHand,
    dealerShouldHit,
    recommendedBlackjackAction,
    settleBlackjackHand,
    shuffledBlackjackShoe,
    type BlackjackAction,
    type BlackjackCard,
  } from '@/lib/blackjack';
  import {
    canClaimTrainingBonus,
    claimTrainingBonus,
    completeTrainingRound,
    readTrainingWallet,
    TRAINING_DAILY_BONUS,
    TRAINING_WALLET_EVENT,
    type TrainingWallet,
  } from '@/lib/training-wallet';

  type Phase = 'betting' | 'player' | 'dealer' | 'complete';
  type PlayerHand = {
    cards: BlackjackCard[];
    stake: number;
    done: boolean;
    fromSplit: boolean;
  };

  const actionLabels: Record<BlackjackAction, string> = {
    hit: 'Hit',
    stand: 'Stand',
    double: 'Double',
    split: 'Split',
  };
  const numberFormat = new Intl.NumberFormat('en-US');
  const wait = (milliseconds: number) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));

  document.querySelectorAll<HTMLElement>('[data-blackjack-game]').forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const dealerCardsRoot = root.querySelector<HTMLElement>('[data-dealer-cards]');
    const dealerScore = root.querySelector<HTMLElement>('[data-dealer-score]');
    const playerHandsRoot = root.querySelector<HTMLElement>('[data-player-hands]');
    const status = root.querySelector<HTMLElement>('[data-blackjack-status]');
    const dealButton = root.querySelector<HTMLButtonElement>('[data-blackjack-deal]');
    const bonusButton = root.querySelector<HTMLButtonElement>('[data-blackjack-bonus]');
    const stakeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-blackjack-stake]')];
    const actionButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-blackjack-action]')];
    const coachTitle = root.querySelector<HTMLElement>('[data-coach-title]');
    const coachCopy = root.querySelector<HTMLElement>('[data-coach-copy]');
    const coachFeedback = root.querySelector<HTMLElement>('[data-coach-feedback]');

    let shoe = shuffledBlackjackShoe();
    let dealerCards: BlackjackCard[] = [];
    let playerHands: PlayerHand[] = [];
    let activeHandIndex = 0;
    let selectedStake = 20;
    let phase: Phase = 'betting';
    let revealDealer = false;
    let animateDealerReveal = false;
    let locked = false;

    const drawCard = () => {
      if (shoe.length < 70) shoe = shuffledBlackjackShoe();
      const card = shoe.pop();
      if (!card) throw new Error('Blackjack shoe is empty.');
      return card;
    };

    const totalStake = () => playerHands.reduce((sum, hand) => sum + hand.stake, 0);
    const activeHand = () => playerHands[activeHandIndex];

    function setStatus(message: string, tone: 'neutral' | 'success' | 'error' = 'neutral') {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
    }

    function cardElement(card: BlackjackCard, hidden = false, index = 0, revealed = false) {
      const wrapper = document.createElement('div');
      wrapper.className = 'playing-card';
      wrapper.classList.toggle('card-back', hidden);
      wrapper.classList.toggle('is-revealed', revealed);
      wrapper.style.setProperty('--deal-index', String(index));
      wrapper.style.setProperty('--card-index', String(index));
      const image = document.createElement('img');
      if (hidden) {
        wrapper.setAttribute('aria-label', 'Face-down dealer card');
        image.src = '/cards/back-cards.png';
        image.alt = '';
        image.width = 292;
        image.height = 424;
        image.draggable = false;
        wrapper.append(image);
        return wrapper;
      }
      image.src = blackjackCardPath(card);
      image.alt = blackjackCardLabel(card);
      image.width = 292;
      image.height = 424;
      image.draggable = false;
      wrapper.append(image);
      return wrapper;
    }

    function renderDealer() {
      if (!dealerCardsRoot || !dealerScore) return;
      dealerCardsRoot.replaceChildren();
      if (!dealerCards.length) {
        const empty = document.createElement('p');
        empty.className = 'empty-hand';
        empty.textContent = 'Dealer cards appear here.';
        dealerCardsRoot.append(empty);
        dealerScore.textContent = '–';
        return;
      }
      dealerCards.forEach((card, index) => dealerCardsRoot.append(cardElement(
        card,
        index === 1 && !revealDealer,
        index,
        index === 1 && animateDealerReveal,
      )));
      dealerScore.textContent = revealDealer
        ? String(blackjackHandValue(dealerCards).total)
        : String(blackjackHandValue([dealerCards[0]]).total);
    }

    function renderPlayerHands() {
      if (!playerHandsRoot) return;
      playerHandsRoot.replaceChildren();
      playerHandsRoot.classList.toggle('is-split', playerHands.length > 1);
      if (!playerHands.length) {
        const zone = document.createElement('div');
        zone.className = 'hand-zone player-hand is-active';
        zone.innerHTML = '<div class="hand-heading"><div><span>Your hand</span><strong>–</strong></div><small>Choose a stake to begin</small></div><div class="card-row"><p class="empty-hand">Your cards appear here.</p></div>';
        playerHandsRoot.append(zone);
        return;
      }

      playerHands.forEach((hand, handIndex) => {
        const value = blackjackHandValue(hand.cards);
        const zone = document.createElement('div');
        zone.className = 'hand-zone player-hand';
        zone.classList.toggle('is-active', phase === 'player' && handIndex === activeHandIndex);
        zone.classList.toggle('is-finished', hand.done);

        const heading = document.createElement('div');
        heading.className = 'hand-heading';
        const label = document.createElement('div');
        const title = document.createElement('span');
        const score = document.createElement('strong');
        const detail = document.createElement('small');
        title.textContent = playerHands.length > 1 ? `Hand ${handIndex + 1}` : 'Your hand';
        score.textContent = String(value.total);
        detail.textContent = `${numberFormat.format(hand.stake)} chips${value.soft ? ' · soft' : ''}${value.blackjack && !hand.fromSplit ? ' · blackjack' : ''}`;
        label.append(title, score);
        heading.append(label, detail);

        const cards = document.createElement('div');
        cards.className = 'card-row';
        hand.cards.forEach((card, cardIndex) => cards.append(cardElement(card, false, cardIndex)));
        zone.append(heading, cards);
        playerHandsRoot.append(zone);
      });
    }

    function actionAvailability() {
      const hand = activeHand();
      const wallet = readTrainingWallet();
      const playing = phase === 'player' && Boolean(hand) && !hand.done && !locked;
      const extraStakeAvailable = playing && totalStake() + hand.stake <= wallet.balance;
      return {
        playing,
        canDouble: Boolean(extraStakeAvailable && hand.cards.length === 2),
        canSplit: Boolean(extraStakeAvailable && playerHands.length === 1 && canSplitBlackjackHand(hand.cards)),
      };
    }

    function renderCoach() {
      actionButtons.forEach((button) => button.classList.remove('is-recommended'));
      if (!coachTitle || !coachCopy) return;
      if (phase !== 'player' || !activeHand() || !dealerCards[0]) {
        coachTitle.textContent = phase === 'complete' ? 'Review the result, then play again' : 'Ready for the first hand';
        coachCopy.textContent = phase === 'complete'
          ? 'The same wallet is available at every practice table.'
          : 'The coach uses a standard multi-deck table where the dealer stands on soft 17.';
        return;
      }
      const availability = actionAvailability();
      const recommendation = recommendedBlackjackAction(activeHand().cards, dealerCards[0], availability);
      coachTitle.textContent = `${actionLabels[recommendation]} is the basic-strategy play`;
      coachCopy.textContent = `Your ${blackjackHandValue(activeHand().cards).total} is compared with the dealer's ${blackjackHandValue([dealerCards[0]]).total}.`;
      root.querySelector<HTMLButtonElement>(`[data-blackjack-action="${recommendation}"]`)?.classList.add('is-recommended');
    }

    function renderControls() {
      const wallet = readTrainingWallet();
      const availability = actionAvailability();
      stakeButtons.forEach((button) => { button.disabled = phase === 'player' || phase === 'dealer' || locked; });
      actionButtons.forEach((button) => {
        const action = button.dataset.blackjackAction as BlackjackAction;
        button.disabled = !availability.playing
          || (action === 'double' && !availability.canDouble)
          || (action === 'split' && !availability.canSplit);
      });
      if (dealButton) {
        dealButton.disabled = phase === 'player' || phase === 'dealer' || locked || selectedStake > wallet.balance;
        dealButton.textContent = phase === 'complete' ? 'New hand' : 'Deal cards';
      }
      renderCoach();
    }

    function renderWallet(wallet: TrainingWallet = readTrainingWallet()) {
      root.querySelectorAll<HTMLElement>('[data-blackjack-balance]').forEach((element) => {
        element.textContent = numberFormat.format(wallet.balance);
      });
      const stats = wallet.gameStats.blackjack;
      const rounds = root.querySelector<HTMLElement>('[data-blackjack-rounds]');
      const wins = root.querySelector<HTMLElement>('[data-blackjack-wins]');
      const returnRate = root.querySelector<HTMLElement>('[data-blackjack-return]');
      if (rounds) rounds.textContent = numberFormat.format(stats.rounds);
      if (wins) wins.textContent = numberFormat.format(stats.winningRounds);
      if (returnRate) returnRate.textContent = stats.totalWagered > 0 ? `${((stats.totalReturned / stats.totalWagered) * 100).toFixed(1)}%` : '–';
      if (bonusButton) {
        const canClaim = canClaimTrainingBonus(wallet);
        bonusButton.disabled = !canClaim;
        bonusButton.textContent = canClaim ? `Claim +${TRAINING_DAILY_BONUS} daily` : 'Daily bonus claimed';
      }
      const history = root.querySelector<HTMLOListElement>('[data-blackjack-history]');
      if (history) {
        history.replaceChildren();
        const entries = wallet.history.filter((entry) => entry.game === 'blackjack').slice(0, 5);
        if (!entries.length) {
          const empty = document.createElement('li');
          empty.textContent = 'No hands played yet.';
          history.append(empty);
        } else {
          entries.forEach((entry) => {
            const item = document.createElement('li');
            const result = document.createElement('span');
            const net = document.createElement('strong');
            result.textContent = entry.result;
            net.textContent = `${entry.net >= 0 ? '+' : ''}${numberFormat.format(entry.net)}`;
            net.dataset.positive = String(entry.net >= 0);
            item.append(result, net);
            history.append(item);
          });
        }
      }
      renderControls();
    }

    function render() {
      renderDealer();
      renderPlayerHands();
      renderControls();
    }

    function noteDecision(action: BlackjackAction) {
      const availability = actionAvailability();
      const recommendation = recommendedBlackjackAction(activeHand().cards, dealerCards[0], availability);
      if (!coachFeedback) return;
      const correct = action === recommendation;
      coachFeedback.textContent = correct
        ? `Good decision: ${actionLabels[action].toLowerCase()} matches basic strategy.`
        : `You chose ${actionLabels[action].toLowerCase()}; basic strategy preferred ${actionLabels[recommendation].toLowerCase()}.`;
      coachFeedback.dataset.correct = String(correct);
    }

    async function settleRound() {
      locked = true;
      revealDealer = true;
      animateDealerReveal = true;
      phase = 'dealer';
      render();
      animateDealerReveal = false;
      const hasLiveHand = playerHands.some((hand) => !blackjackHandValue(hand.cards).bust);
      while (hasLiveHand && dealerShouldHit(dealerCards)) {
        await wait(430);
        dealerCards.push(drawCard());
        renderDealer();
      }
      await wait(280);

      const settlements = playerHands.map((hand) => settleBlackjackHand(hand.cards, dealerCards, hand.stake, !hand.fromSplit));
      const wagered = totalStake();
      const payout = settlements.reduce((sum, settlement) => sum + settlement.payout, 0);
      const result = settlements.map((settlement, index) => `${playerHands.length > 1 ? `H${index + 1} ` : ''}${settlement.result}`).join(' · ');
      const completed = completeTrainingRound({ game: 'blackjack', result, wagered, payout });
      phase = 'complete';
      locked = false;
      render();
      renderWallet(completed.wallet);
      if (!completed.completed) {
        setStatus('The shared balance changed during this hand. No chips were deducted.', 'error');
        return;
      }
      const net = payout - wagered;
      setStatus(
        net > 0 ? `${numberFormat.format(payout)} chips returned · +${numberFormat.format(net)} net.`
          : net === 0 ? 'Push: your stake was returned.'
            : `${numberFormat.format(Math.abs(net))} chips lost this hand.`,
        net > 0 ? 'success' : 'neutral',
      );
    }

    async function moveToNextHand() {
      const nextIndex = playerHands.findIndex((hand, index) => index > activeHandIndex && !hand.done);
      if (nextIndex >= 0) {
        activeHandIndex = nextIndex;
        render();
        setStatus(`Play hand ${activeHandIndex + 1}.`);
        return;
      }
      await settleRound();
    }

    async function dealRound() {
      if (locked || selectedStake > readTrainingWallet().balance) return;
      locked = true;
      phase = 'betting';
      revealDealer = false;
      dealerCards = [];
      playerHands = [{ cards: [], stake: selectedStake, done: false, fromSplit: false }];
      activeHandIndex = 0;
      if (coachFeedback) coachFeedback.textContent = '';
      render();
      setStatus('Dealing the cards…');

      for (const target of ['player', 'dealer', 'player', 'dealer'] as const) {
        await wait(190);
        if (target === 'player') playerHands[0].cards.push(drawCard());
        else dealerCards.push(drawCard());
        render();
      }

      locked = false;
      const playerNatural = blackjackHandValue(playerHands[0].cards).blackjack;
      const dealerNatural = blackjackHandValue(dealerCards).blackjack;
      if (playerNatural || dealerNatural) {
        setStatus(playerNatural ? 'Blackjack.' : 'Dealer blackjack.');
        await settleRound();
        return;
      }
      phase = 'player';
      render();
      setStatus('Choose your action. The recommended play is highlighted.');
    }

    async function playAction(action: BlackjackAction) {
      if (locked || phase !== 'player') return;
      const hand = activeHand();
      if (!hand || hand.done) return;
      const availability = actionAvailability();
      if ((action === 'double' && !availability.canDouble) || (action === 'split' && !availability.canSplit)) return;
      noteDecision(action);

      if (action === 'hit') {
        hand.cards.push(drawCard());
        const value = blackjackHandValue(hand.cards);
        if (value.bust || value.total === 21) hand.done = true;
        render();
        setStatus(value.bust ? `Hand ${activeHandIndex + 1} busts with ${value.total}.` : `Your hand is now ${value.total}.`, value.bust ? 'error' : 'neutral');
        if (hand.done) await moveToNextHand();
        return;
      }

      if (action === 'stand') {
        hand.done = true;
        render();
        setStatus(`Standing on ${blackjackHandValue(hand.cards).total}.`);
        await moveToNextHand();
        return;
      }

      if (action === 'double') {
        hand.stake *= 2;
        hand.cards.push(drawCard());
        hand.done = true;
        render();
        setStatus(`Stake doubled. Final hand: ${blackjackHandValue(hand.cards).total}.`);
        await moveToNextHand();
        return;
      }

      const [first, second] = hand.cards;
      playerHands = [
        { cards: [first, drawCard()], stake: hand.stake, done: first.rank === 1, fromSplit: true },
        { cards: [second, drawCard()], stake: hand.stake, done: second.rank === 1, fromSplit: true },
      ];
      activeHandIndex = 0;
      render();
      setStatus(first.rank === 1 ? 'Split aces receive one card each.' : 'Pair split into two hands. Play hand 1.');
      if (first.rank === 1) await settleRound();
    }

    stakeButtons.forEach((button) => button.addEventListener('click', () => {
      selectedStake = Number(button.dataset.blackjackStake || 20);
      stakeButtons.forEach((candidate) => {
        const selected = candidate === button;
        candidate.classList.toggle('selected', selected);
        candidate.setAttribute('aria-pressed', String(selected));
      });
      setStatus(`${numberFormat.format(selectedStake)}-chip stake selected.`);
      renderControls();
    }));
    actionButtons.forEach((button) => button.addEventListener('click', () => playAction(button.dataset.blackjackAction as BlackjackAction)));
    dealButton?.addEventListener('click', dealRound);
    bonusButton?.addEventListener('click', () => {
      const { claimed, wallet } = claimTrainingBonus();
      renderWallet(wallet);
      setStatus(claimed ? `Daily bonus: +${TRAINING_DAILY_BONUS} chips.` : 'Today’s bonus has already been claimed.', claimed ? 'success' : 'neutral');
    });
    window.addEventListener(TRAINING_WALLET_EVENT, (event) => renderWallet((event as CustomEvent<TrainingWallet>).detail));
    window.addEventListener('storage', () => renderWallet());
    renderWallet();
    render();
  });
</script>

<style>
  .blackjack-game { color: #fff; scroll-margin-top: 30px; }
  .blackjack-shell { overflow: hidden; padding: 34px; border-radius: 30px; background: #102f2a; box-shadow: 0 26px 70px rgba(13,48,41,.18); }
  .blackjack-header { display: flex; align-items: start; justify-content: space-between; gap: 32px; margin-bottom: 28px; }
  .blackjack-kicker { margin: 0 0 10px; color: var(--lime); font-size: .72rem; font-weight: 800; letter-spacing: .12em; line-height: 1; text-transform: uppercase; }
  .blackjack-header h2 { margin: 0; color: #fff; font-size: clamp(1.9rem, 4vw, 3rem); }
  .blackjack-header p:last-child { max-width: 560px; margin: 10px 0 0; color: #bcd0ca; }
  .blackjack-wallet { min-width: 150px; display: grid; grid-template-columns: 24px auto; align-items: center; column-gap: 8px; padding: 13px 16px; border: 1px solid rgba(255,255,255,.15); border-radius: 18px; background: rgba(255,255,255,.075); }
  .blackjack-wallet strong { color: #fff; font-size: 1.15rem; line-height: 1; }
  .blackjack-wallet small { grid-column: 2; margin-top: 3px; color: #a9c2ba; font-size: .7rem; }
  .blackjack-chip { grid-row: 1 / 3; width: 23px; aspect-ratio: 1; border: 4px dotted #4d615b; border-radius: 50%; background: var(--lime); }
  .blackjack-table { position: relative; min-height: 590px; padding: 28px; overflow: hidden; border: 1px solid rgba(255,255,255,.13); border-radius: 120px 120px 24px 24px; background: radial-gradient(circle at 50% 42%, rgba(93,151,126,.35), transparent 46%), #155344; box-shadow: inset 0 0 0 8px rgba(6,30,25,.2); }
  .blackjack-table::before { content: ''; position: absolute; inset: 17px; border: 1px solid rgba(255,255,255,.12); border-radius: 105px 105px 18px 18px; pointer-events: none; }
  .hand-zone { position: relative; z-index: 1; }
  .dealer-zone { max-width: 570px; margin-inline: auto; }
  .hand-heading { min-height: 34px; display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 12px; }
  .hand-heading > div { display: flex; align-items: baseline; gap: 10px; }
  .hand-heading span { color: #d9e7e1; font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .hand-heading strong { color: var(--lime); font-size: 1.25rem; }
  .hand-heading small { color: #a8c6bb; font-size: .7rem; }
  .card-row { min-height: 144px; display: flex; align-items: center; justify-content: center; gap: 10px; }
  .empty-hand { margin: 0; color: rgba(222,239,232,.57); font-size: .78rem; }
  .playing-card { width: clamp(76px, 8vw, 102px); aspect-ratio: 5 / 7; flex: 0 0 auto; overflow: hidden; border-radius: 8px; background: #fff; box-shadow: 0 9px 20px rgba(3,22,17,.28); animation: blackjack-deal .3s ease both; animation-delay: calc(var(--deal-index) * 35ms); }
  .playing-card img { width: 100%; height: 100%; display: block; object-fit: contain; user-select: none; }
  .card-back { border: 5px solid #f8f4e9; background: repeating-linear-gradient(45deg, #a92f38 0 6px, #76242c 6px 12px); box-shadow: inset 0 0 0 2px #fff, 0 9px 20px rgba(3,22,17,.28); }
  .table-rule { position: relative; z-index: 1; display: grid; grid-template-columns: auto minmax(40px, 1fr) auto; align-items: center; gap: 16px; max-width: 650px; margin: 23px auto; color: #9fc4b7; font-size: .64rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .table-rule i { height: 1px; background: rgba(255,255,255,.18); }
  .player-hands { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; max-width: 790px; margin-inline: auto; }
  .player-hand { padding: 14px; border: 1px solid transparent; border-radius: 18px; background: rgba(5,40,32,.12); }
