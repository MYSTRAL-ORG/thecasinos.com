---
import RouletteGame from '@/components/RouletteGame.astro';
import BlackjackGame from '@/components/BlackjackGame.astro';
---

<section class="casino-room" id="training-room" data-casino-room aria-label="Casino training room">
  <div class="room-frame">
    <header class="room-bar">
      <button type="button" class="room-back" data-room-lobby aria-label="Return to the game lobby" hidden>
        <span aria-hidden="true">‹</span><span>Games</span>
      </button>
      <div class="room-brand">
        <span class="room-brand-mark" aria-hidden="true">T</span>
        <div><small>Free play</small><strong data-room-title>Casino lobby</strong></div>
      </div>
      <output class="room-wallet" aria-label="Practice chip balance">
        <span class="room-wallet-chip" aria-hidden="true"></span>
        <strong data-room-balance>2,000</strong><small>chips</small>
      </output>
    </header>

    <main class="room-stage">
      <section class="room-panel room-lobby" id="room-panel-lobby" data-room-panel="lobby" role="tabpanel" aria-labelledby="room-tab-lobby">
        <div class="lobby-heading">
          <div>
            <p>Training room</p>
            <h2 id="lobby-title" tabindex="-1">Choose your table.</h2>
            <span>Learn the rules with fictional chips. No registration and no real money.</span>
          </div>
          <div class="lobby-bonus">
            <small>Practice balance</small>
            <strong><span data-room-balance>2,000</span> chips</strong>
            <button type="button" data-room-bonus>Claim +500 daily</button>
          </div>
        </div>

        <div class="lobby-grid">
          <article class="game-tile game-tile-live roulette-tile">
            <div class="game-preview roulette-preview" aria-hidden="true">
              <div class="preview-wheel"><span>0</span></div>
              <div class="preview-results"><i></i><i></i><i></i></div>
            </div>
            <div class="game-tile-copy">
              <p>European table · 0–36</p>
              <h3>Roulette</h3>
              <span>Place inside and outside bets, then watch the wheel settle.</span>
            </div>
            <div class="game-tile-footer">
              <small><strong data-room-roulette-rounds>0</strong> rounds played</small>
              <button type="button" data-open-game="roulette">Play roulette <span aria-hidden="true">→</span></button>
            </div>
          </article>

          <article class="game-tile game-tile-live blackjack-tile">
            <div class="game-preview blackjack-preview" aria-hidden="true">
              <img src="/cards/spade/1.png" alt="" width="292" height="424" />
              <img src="/cards/heart/13.png" alt="" width="292" height="424" />
              <span class="preview-chip">20</span>
            </div>
            <div class="game-tile-copy">
              <p>Strategy table · pays 3:2</p>
              <h3>Blackjack</h3>
              <span>Choose a bet, play the hand and learn the recommended decision.</span>
            </div>
            <div class="game-tile-footer">
              <small><strong data-room-blackjack-rounds>0</strong> hands played</small>
              <button type="button" data-open-game="blackjack">Play blackjack <span aria-hidden="true">→</span></button>
            </div>
          </article>

          <article class="game-tile game-tile-soon" aria-disabled="true">
            <div class="soon-symbol poker-symbol" aria-hidden="true">
              <img src="/cards/diamond/10.png" alt="" width="292" height="424" />
              <img src="/cards/diamond/11.png" alt="" width="292" height="424" />
              <img src="/cards/diamond/12.png" alt="" width="292" height="424" />
            </div>
            <div><p>Coming next</p><h3>Video poker</h3></div><span class="soon-badge">Soon</span>
          </article>

          <article class="game-tile game-tile-soon" aria-disabled="true">
            <div class="soon-symbol slots-symbol" aria-hidden="true"><span>7</span><span>●</span><span>★</span></div>
            <div><p>Probability lab</p><h3>Slot machine</h3></div><span class="soon-badge">Planned</span>
          </article>
        </div>
      </section>

      <section class="room-panel game-panel" id="room-panel-roulette" data-room-panel="roulette" role="tabpanel" aria-labelledby="room-tab-roulette" hidden inert>
        <h2 class="sr-only" tabindex="-1" data-panel-heading>European roulette</h2>
        <RouletteGame title="European roulette" framed />
      </section>

      <section class="room-panel game-panel" id="room-panel-blackjack" data-room-panel="blackjack" role="tabpanel" aria-labelledby="room-tab-blackjack" hidden inert>
        <h2 class="sr-only" tabindex="-1" data-panel-heading>Blackjack strategy table</h2>
        <BlackjackGame framed />
      </section>
    </main>

    <nav class="room-dock" role="tablist" aria-label="Training room navigation">
      <button type="button" id="room-tab-lobby" data-room-nav="lobby" class="is-active" role="tab" aria-controls="room-panel-lobby" aria-selected="true" aria-current="page">
        <span class="dock-icon lobby-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>Lobby</span>
      </button>
      <button type="button" id="room-tab-roulette" data-room-nav="roulette" role="tab" aria-controls="room-panel-roulette" aria-selected="false">
        <span class="dock-icon wheel-icon" aria-hidden="true"></span><span>Roulette</span>
      </button>
      <button type="button" id="room-tab-blackjack" data-room-nav="blackjack" role="tab" aria-controls="room-panel-blackjack" aria-selected="false">
        <span class="dock-icon cards-icon" aria-hidden="true"><i></i><i></i></span><span>Blackjack</span>
      </button>
    </nav>
  </div>
</section>

<script>
  import { animate } from 'motion/mini';
  import {
    canClaimTrainingBonus,
    claimTrainingBonus,
    readTrainingWallet,
    TRAINING_DAILY_BONUS,
    TRAINING_WALLET_EVENT,
    type TrainingWallet,
  } from '@/lib/training-wallet';

  type RoomView = 'lobby' | 'roulette' | 'blackjack';
  const roomTitles: Record<RoomView, string> = {
    lobby: 'Casino lobby',
    roulette: 'European roulette',
    blackjack: 'Blackjack',
  };

  document.querySelectorAll<HTMLElement>('[data-casino-room]').forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const frame = root.querySelector<HTMLElement>('.room-frame');
    const stage = root.querySelector<HTMLElement>('.room-stage');
    const title = root.querySelector<HTMLElement>('[data-room-title]');
    const backButton = root.querySelector<HTMLButtonElement>('[data-room-lobby]');
    const bonusButton = root.querySelector<HTMLButtonElement>('[data-room-bonus]');
    const panels = [...root.querySelectorAll<HTMLElement>('[data-room-panel]')];
    const navButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-room-nav]')];
    const openButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-open-game]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeView: RoomView = 'lobby';
    let switching = false;
    let busyGame: RoomView | null = null;

    const panelFor = (view: RoomView) => panels.find((panel) => panel.dataset.roomPanel === view);

    function renderWallet(wallet: TrainingWallet = readTrainingWallet()) {
      root.querySelectorAll<HTMLElement>('[data-room-balance]').forEach((element) => {
        element.textContent = new Intl.NumberFormat('en-US').format(wallet.balance);
      });
      const rouletteRounds = root.querySelector<HTMLElement>('[data-room-roulette-rounds]');
      const blackjackRounds = root.querySelector<HTMLElement>('[data-room-blackjack-rounds]');
      if (rouletteRounds) rouletteRounds.textContent = String(wallet.gameStats.roulette.rounds);
      if (blackjackRounds) blackjackRounds.textContent = String(wallet.gameStats.blackjack.rounds);
      if (bonusButton) {
        const canClaim = canClaimTrainingBonus(wallet);
        bonusButton.disabled = !canClaim;
        bonusButton.textContent = canClaim ? `Claim +${TRAINING_DAILY_BONUS} daily` : 'Daily bonus claimed';
      }
    }

    function updateNavigation(view: RoomView) {
      if (title) title.textContent = roomTitles[view];
      if (backButton) backButton.hidden = view === 'lobby';
      navButtons.forEach((button) => {
        const selected = button.dataset.roomNav === view;
        button.classList.toggle('is-active', selected);
        button.toggleAttribute('aria-current', selected);
        if (button.hasAttribute('role')) button.setAttribute('aria-selected', String(selected));
      });
    }

    async function showView(next: RoomView, updateHash = true) {
      if (next === activeView || switching) return;
      if (busyGame && busyGame !== next) {
        const busyPanel = panelFor(busyGame);
        const status = busyPanel?.querySelector<HTMLElement>('[aria-live="polite"]');
        if (status) status.textContent = busyGame === 'roulette' ? 'Wait for the wheel to stop.' : 'Wait for the cards to finish dealing.';
        return;
      }
      const currentPanel = panelFor(activeView);
      const nextPanel = panelFor(next);
      if (!currentPanel || !nextPanel) return;
      switching = true;
      navButtons.forEach((button) => { button.disabled = true; });

      if (!reduceMotion) {
        await animate(currentPanel, { opacity: [1, 0], transform: ['translateX(0)', 'translateX(-18px)'] }, { duration: .16, ease: 'easeIn' }).finished;
      }
      currentPanel.hidden = true;
      currentPanel.inert = true;
      currentPanel.setAttribute('aria-hidden', 'true');
      nextPanel.hidden = false;
      nextPanel.inert = false;
      nextPanel.removeAttribute('aria-hidden');
      activeView = next;
      updateNavigation(next);
      if (stage) stage.scrollTop = 0;
      if (!reduceMotion) {
        await animate(nextPanel, { opacity: [0, 1], transform: ['translateX(18px)', 'translateX(0)'] }, { duration: .24, ease: [0.22, 1, 0.36, 1] }).finished;
      }

      switching = false;
      navButtons.forEach((button) => { button.disabled = false; });
      root.dataset.activeView = next;
      if (updateHash) {
        const target = next === 'lobby' ? `${window.location.pathname}${window.location.search}` : `#${next}`;
        window.history.replaceState(null, '', target);
      }
      nextPanel.querySelector<HTMLElement>('[data-panel-heading], #lobby-title')?.focus({ preventScroll: true });
    }

    openButtons.forEach((button) => button.addEventListener('click', () => showView(button.dataset.openGame as RoomView)));
    navButtons.forEach((button) => button.addEventListener('click', () => showView(button.dataset.roomNav as RoomView)));
    backButton?.addEventListener('click', () => showView('lobby'));
    bonusButton?.addEventListener('click', () => renderWallet(claimTrainingBonus().wallet));

    root.addEventListener('thecasinos:game-phase', (event) => {
      const detail = (event as CustomEvent<{ game: RoomView; busy: boolean }>).detail;
      if (!detail) return;
      busyGame = detail.busy ? detail.game : busyGame === detail.game ? null : busyGame;
      navButtons.forEach((button) => {
        button.disabled = Boolean(busyGame && button.dataset.roomNav !== activeView);
      });
      if (backButton) backButton.disabled = Boolean(busyGame);
    });
    window.addEventListener(TRAINING_WALLET_EVENT, (event) => renderWallet((event as CustomEvent<TrainingWallet>).detail));
    window.addEventListener('storage', () => renderWallet());

    const initialHash = window.location.hash.slice(1);
    const initialView: RoomView = initialHash === 'roulette' || initialHash === 'blackjack' ? initialHash : 'lobby';
    if (initialView !== 'lobby') showView(initialView, false);
    renderWallet();
    updateNavigation(activeView);
    root.dataset.activeView = activeView;
    if (!reduceMotion && frame) {
      animate(frame, { opacity: [0, 1], transform: ['translateY(18px) scale(.99)', 'translateY(0) scale(1)'] }, { duration: .5, ease: [0.22, 1, 0.36, 1] });
      root.querySelectorAll<HTMLElement>('.game-tile').forEach((tile, index) => {
        animate(tile, { opacity: [0, 1], transform: ['translateY(14px)', 'translateY(0)'] }, { duration: .38, delay: .12 + index * .06 });
      });
    }
  });
</script>

<style>
  .casino-room { width: min(1240px, calc(100% - 28px)); margin: 28px auto 94px; color: #fff; scroll-margin-top: 12px; }
  .room-frame { height: clamp(680px, calc(100svh - 44px), 840px); min-height: 680px; display: grid; grid-template-rows: 64px minmax(0, 1fr) 66px; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 32px; background: #071b17; box-shadow: 0 34px 90px rgba(10, 41, 34, .24); }
  .room-bar { position: relative; z-index: 8; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 22px; border-bottom: 1px solid rgba(255,255,255,.09); background: rgba(6, 26, 22, .96); }
  .room-back { width: fit-content; min-height: 42px; display: flex; align-items: center; gap: 6px; padding: 0 10px; border: 0; border-radius: 12px; background: transparent; color: #dce9e4; cursor: pointer; font: 800 .75rem/1 Arial, sans-serif; }
  .room-back[hidden] { display: none !important; }
  .room-back > span:first-child { font-size: 1.5rem; font-weight: 400; }
  .room-back:hover:not(:disabled) { background: rgba(255,255,255,.07); }
  .room-brand { grid-column: 2; display: flex; align-items: center; gap: 10px; text-align: left; }
  .room-brand-mark { width: 32px; aspect-ratio: 1; display: grid; place-items: center; border-radius: 10px; background: var(--lime); color: #143f37; font: 900 .86rem/1 Arial, sans-serif; }
  .room-brand div { display: grid; gap: 2px; }
  .room-brand small { color: #7f9e94; font: 750 .58rem/1 Arial, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .room-brand strong { color: #fff; font: 850 .82rem/1 Arial, sans-serif; }
  .room-wallet { grid-column: 3; justify-self: end; display: grid; grid-template-columns: 24px auto; align-items: center; column-gap: 8px; padding: 8px 12px; border: 1px solid rgba(255,255,255,.11); border-radius: 14px; background: rgba(255,255,255,.055); }
  .room-wallet-chip { grid-row: 1 / 3; width: 23px; aspect-ratio: 1; border: 4px dotted #53665f; border-radius: 50%; background: var(--lime); }
  .room-wallet strong { color: #fff; font: 850 .86rem/1 Arial, sans-serif; }
  .room-wallet small { color: #87a59b; font-size: .57rem; line-height: 1; }
  .room-stage { position: relative; min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; background: radial-gradient(circle at 12% 10%, rgba(78, 137, 114, .2), transparent 33%), #0a211d; scrollbar-color: #35564c transparent; }
  .room-panel { min-height: 100%; }
  .room-panel[hidden] { display: none !important; }
  .game-panel { padding: 18px; }
  .room-lobby { padding: clamp(26px, 4vw, 54px); background: radial-gradient(circle at 88% 12%, rgba(215,232,118,.12), transparent 27%); }
  .lobby-heading { display: flex; align-items: end; justify-content: space-between; gap: 50px; margin-bottom: 30px; }
  .lobby-heading p { margin: 0 0 9px; color: var(--lime); font: 850 .64rem/1 Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; }
  .lobby-heading h2 { margin: 0; color: #fff; font-size: clamp(2.25rem, 4.5vw, 4rem); letter-spacing: -.055em; }
  .lobby-heading > div:first-child > span { display: block; max-width: 570px; margin-top: 10px; color: #98b1a9; font-size: .85rem; line-height: 1.55; }
  .lobby-bonus { min-width: 225px; display: grid; gap: 5px; padding: 16px; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: rgba(255,255,255,.05); }
  .lobby-bonus small { color: #8ca79e; font-size: .64rem; }
  .lobby-bonus strong { color: #fff; font-size: 1.1rem; }
  .lobby-bonus button { min-height: 38px; margin-top: 7px; border: 0; border-radius: 12px; background: var(--lime); color: #173f37; cursor: pointer; font-size: .7rem; font-weight: 850; }
  .lobby-bonus button:disabled { opacity: .45; cursor: default; }
  .lobby-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .game-tile { position: relative; min-width: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.11); border-radius: 24px; background: rgba(255,255,255,.045); }
  .game-tile-live { min-height: 330px; display: grid; grid-template-columns: minmax(150px, .82fr) minmax(0, 1.18fr); grid-template-rows: 1fr auto; }
  .game-preview { position: relative; grid-row: 1 / 3; min-height: 300px; display: grid; place-items: center; overflow: hidden; }
  .roulette-preview { background: radial-gradient(circle at center, rgba(215,232,118,.18), transparent 47%), #123b33; }
  .preview-wheel { width: 160px; aspect-ratio: 1; display: grid; place-items: center; border: 12px solid #071f1a; border-radius: 50%; background: repeating-conic-gradient(#c94b54 0 9.72deg, #171e1c 9.72deg 19.44deg); box-shadow: 0 22px 38px rgba(0,0,0,.28), inset 0 0 0 3px rgba(255,255,255,.14); transform: rotate(-12deg); }
  .preview-wheel::before { content: ''; position: absolute; width: 70px; aspect-ratio: 1; border: 9px solid rgba(5, 26, 21, .7); border-radius: 50%; background: #d7e876; }
  .preview-wheel span { position: relative; z-index: 1; color: #173f37; font-weight: 900; }
  .preview-results { position: absolute; bottom: 28px; display: flex; gap: 7px; }
  .preview-results i { width: 9px; aspect-ratio: 1; border-radius: 50%; background: #d94c55; }
  .preview-results i:nth-child(2) { background: #141c1a; }.preview-results i:nth-child(3) { background: #4c9c70; }
  .blackjack-preview { background: radial-gradient(circle at 48% 45%, rgba(119,183,153,.28), transparent 48%), #11463a; }
  .blackjack-preview img { position: absolute; width: 88px; height: auto; border-radius: 9px; box-shadow: 0 16px 24px rgba(0,0,0,.26); }
  .blackjack-preview img:first-child { transform: translate(-29px, -8px) rotate(-8deg); }.blackjack-preview img:nth-child(2) { transform: translate(27px, 5px) rotate(7deg); }
  .preview-chip { position: absolute; z-index: 2; bottom: 33px; width: 50px; aspect-ratio: 1; display: grid; place-items: center; border: 5px dotted #33463f; border-radius: 50%; background: var(--lime); color: #173f37; font-size: .7rem; font-weight: 900; box-shadow: 0 8px 15px rgba(0,0,0,.28); }
  .game-tile-copy { align-self: end; padding: 25px 24px 14px; }
  .game-tile-copy p, .game-tile-soon p { margin: 0 0 7px; color: #89aa9f; font: 800 .61rem/1 Arial, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .game-tile-copy h3, .game-tile-soon h3 { margin: 0; color: #fff; font-size: 1.6rem; }
  .game-tile-copy > span { display: block; margin-top: 10px; color: #9eb5ae; font-size: .75rem; line-height: 1.5; }
  .game-tile-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 20px 20px 24px; }
  .game-tile-footer small { color: #77958b; font-size: .63rem; }.game-tile-footer small strong { color: #b9cec7; }
  .game-tile-footer button { min-height: 42px; padding: 0 15px; border: 0; border-radius: 13px; background: var(--lime); color: #173f37; cursor: pointer; font-size: .7rem; font-weight: 900; }
  .game-tile-footer button:hover { transform: translateY(-1px); filter: brightness(1.04); }
  .game-tile-soon { min-height: 118px; display: grid; grid-template-columns: 122px 1fr auto; align-items: center; gap: 18px; padding: 14px 18px 14px 12px; opacity: .63; }
  .soon-symbol { height: 88px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 14px; background: rgba(255,255,255,.045); }
  .poker-symbol img { width: 40px; height: auto; margin-inline: -8px; border-radius: 4px; box-shadow: 0 7px 10px rgba(0,0,0,.2); }.poker-symbol img:first-child { transform: rotate(-9deg); }.poker-symbol img:last-child { transform: rotate(9deg); }
  .slots-symbol { gap: 3px; }.slots-symbol span { width: 28px; height: 42px; display: grid; place-items: center; border-radius: 4px; background: #e8eadf; color: #8f2c35; font-size: .72rem; font-weight: 900; }.slots-symbol span:nth-child(2) { color: #18211e; }
  .soon-badge { padding: 6px 9px; border-radius: 999px; background: rgba(255,255,255,.08); color: #a9beb7; font-size: .58rem; font-weight: 800; text-transform: uppercase; }
  .room-dock { position: relative; z-index: 8; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255,255,255,.09); background: rgba(6, 26, 22, .98); }
  .room-dock button { min-width: 0; display: flex; align-items: center; justify-content: center; gap: 9px; border: 0; border-right: 1px solid rgba(255,255,255,.055); background: transparent; color: #77978c; cursor: pointer; font-size: .68rem; font-weight: 800; }
  .room-dock button:last-child { border-right: 0; }.room-dock button.is-active { color: #fff; background: rgba(255,255,255,.035); }.room-dock button:disabled { opacity: .4; cursor: default; }
  .dock-icon { width: 24px; height: 24px; position: relative; display: grid; place-items: center; }
  .lobby-icon { grid-template-columns: 1fr 1fr; gap: 2px; }.lobby-icon i { width: 9px; height: 9px; border: 1.5px solid currentColor; border-radius: 3px; }
  .wheel-icon { border: 2px solid currentColor; border-radius: 50%; }.wheel-icon::before, .wheel-icon::after { content: ''; position: absolute; width: 2px; height: 18px; background: currentColor; transform: rotate(45deg); }.wheel-icon::after { transform: rotate(-45deg); }
  .cards-icon i { position: absolute; width: 14px; height: 19px; border: 1.5px solid currentColor; border-radius: 3px; }.cards-icon i:first-child { transform: translateX(-3px) rotate(-8deg); }.cards-icon i:last-child { transform: translateX(4px) rotate(7deg); }
  .sr-only { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0,0,0,0) !important; white-space: nowrap !important; border: 0 !important; }
  button:focus-visible, [tabindex='-1']:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @media (max-width: 900px) {
    .lobby-heading { align-items: stretch; flex-direction: column; gap: 18px; }.lobby-bonus { width: min(100%, 290px); }.lobby-grid { grid-template-columns: 1fr; }.game-tile-live { min-height: 290px; }
  }
  @media (max-width: 680px) {
    .casino-room { width: 100%; margin-top: 8px; margin-bottom: 60px; }
    .room-frame { height: calc(100svh - 8px); min-height: 620px; grid-template-rows: 54px minmax(0, 1fr) calc(61px + env(safe-area-inset-bottom)); border-inline: 0; border-radius: 0 0 20px 20px; }
    .room-bar { padding-inline: 10px; }.room-brand-mark { display: none; }.room-brand small { font-size: .52rem; }.room-brand strong { font-size: .72rem; }.room-back { padding-inline: 4px; }.room-back > span:last-child { display: none; }
