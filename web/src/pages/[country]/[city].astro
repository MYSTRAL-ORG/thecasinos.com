---
import CityDirectoryPage from '@/components/CityDirectoryPage.astro';

const country = Astro.params.country ?? '';
const city = Astro.params.city ?? '';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, durable, max-age=3600, stale-while-revalidate=43200');
---

<CityDirectoryPage country={country} city={city} page={1} />
