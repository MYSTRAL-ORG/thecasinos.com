---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CasinoCard from '@/components/CasinoCard.astro';
import { getCasinoByPath, getCasinosByLocation } from '@/lib/data';
import { getCasinoImageUrl } from '@/lib/media';
import { breadcrumbSchema, casinoPageDescription, casinoPageTitle } from '@/lib/seo';

const country = Astro.params.country ?? '';
const city = Astro.params.city ?? '';
const slug = Astro.params.slug ?? '';
const [casino, cityCasinos] = await Promise.all([
  getCasinoByPath(country, city, slug),
  getCasinosByLocation(country, city, 7),
]);
if (!casino) Astro.response.status = 404;
const relatedCasinos = casino
  ? cityCasinos.filter((item) => item.id !== casino.id).slice(0, 3)
  : [];

const openedOn = casino?.verified_opened_on || casino?.opened_on;
const facts = casino ? [
  openedOn && { label: casino.verified_opened_on ? 'Opened · cross-checked' : 'Opened · listing data', value: new Date(`${openedOn}T00:00:00`).getFullYear().toString() },
  casino.gaming_machines != null && casino.gaming_machines > 0 && { label: 'Gaming machines · listed', value: casino.gaming_machines.toLocaleString('en-US') },
  casino.table_games != null && casino.table_games > 0 && { label: 'Table games · listed', value: casino.table_games.toLocaleString('en-US') },
  casino.poker_tables != null && casino.poker_tables > 0 && { label: 'Poker tables · listed', value: casino.poker_tables.toLocaleString('en-US') },
  casino.square_footage != null && casino.square_footage > 0 && { label: 'Gaming floor · listed', value: `${casino.square_footage.toLocaleString('en-US')} sq ft` },
].filter(Boolean) as { label: string; value: string }[] : [];

const image = casino ? getCasinoImageUrl(casino, { width: 1200, height: 800, quality: 82 }) : null;
const imageMedium = casino ? getCasinoImageUrl(casino, { width: 760, height: 520, quality: 80 }) : null;
const unverifiedLegacyEntities = [casino?.owner_name, casino?.hotel_name]
  .filter((value): value is string => Boolean(value?.trim()))
  .map((value) => value.toLocaleLowerCase('en').replace(/\s+/g, ' ').trim())
  .filter((value) => value.length >= 3 && !['n/a', 'none', 'unknown'].includes(value));
const mentionsUnverifiedLegacyEntity = (value?: string | null) => {
  const normalized = value?.toLocaleLowerCase('en').replace(/\s+/g, ' ').trim();
  return Boolean(normalized && unverifiedLegacyEntities.some((entity) => normalized.includes(entity)));
};
const neutralIntro = casino
  ? `${casino.name.trim()} is a land-based casino in ${casino.city_name}, ${casino.country_name}. ${casino.wikidata_id ? 'Its venue identity and location have been cross-checked against an open-data source.' : 'Historical listing details are being cross-checked before publication as verified facts.'}`
  : '';
const introCandidate = casino?.summary || casino?.description;
const heroIntro = mentionsUnverifiedLegacyEntity(introCandidate) ? neutralIntro : introCandidate;
const rawParagraphs = casino?.editorial_paragraphs?.filter(Boolean).length
  ? casino.editorial_paragraphs.filter(Boolean)
  : [casino?.description].filter(Boolean) as string[];
const paragraphs = rawParagraphs.filter((paragraph) => !mentionsUnverifiedLegacyEntity(paragraph));
const gamesDescription = mentionsUnverifiedLegacyEntity(casino?.games_description) ? null : casino?.games_description;
const funFacts = mentionsUnverifiedLegacyEntity(casino?.fun_facts) ? null : casino?.fun_facts;
const pageTitle = casino ? casinoPageTitle(casino) : 'Casino not found';
const pageDescriptionCandidate = casino ? casinoPageDescription(casino) : `Casino information for ${city}.`;
const pageDescription = mentionsUnverifiedLegacyEntity(pageDescriptionCandidate)
  ? neutralIntro
  : pageDescriptionCandidate;
const canonicalPath = casino ? `/${casino.country_slug}/${casino.city_slug}/${casino.slug}` : Astro.url.pathname;
const sourceUrls = casino?.verification_source_urls?.filter((source) => /^https:\/\//.test(source)) ?? [];
const officialWebsiteUrl = /^https?:\/\//i.test(casino?.official_website_url ?? '')
  ? casino?.official_website_url
  : null;
const sameAs = [officialWebsiteUrl, casino?.wikidata_id ? `https://www.wikidata.org/wiki/${casino.wikidata_id}` : null].filter(Boolean);
const lastVerifiedLabel = casino?.last_verified_at
  ? new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(casino.last_verified_at))
  : null;
const structuredData = casino ? [
  breadcrumbSchema([
    { name: 'Casino directory', path: '/casinos' },
    { name: casino.country_name, path: `/${casino.country_slug}` },
    { name: casino.city_name, path: `/${casino.country_slug}/${casino.city_slug}` },
    { name: casino.name.trim(), path: canonicalPath },
  ], Astro.site?.toString()),
  {
    '@context': 'https://schema.org',
    '@type': 'Casino',
    '@id': new URL(`${canonicalPath}#casino`, Astro.site).toString(),
    url: new URL(canonicalPath, Astro.site).toString(),
    name: casino.name.trim(),
    description: pageDescription,
    image: image ? new URL(image, Astro.site).toString() : undefined,
    address: { '@type': 'PostalAddress', streetAddress: casino.street_address, addressLocality: casino.city_name, addressRegion: casino.state_name, addressCountry: casino.country_name },
    geo: casino.latitude != null && casino.longitude != null ? { '@type': 'GeoCoordinates', latitude: casino.latitude, longitude: casino.longitude } : undefined,
    telephone: casino.phone || undefined,
    foundingDate: casino.verified_opened_on || undefined,
    openingHours: casino.always_open ? 'Mo-Su 00:00-23:59' : undefined,
    sameAs: sameAs.length ? sameAs : undefined,
    mainEntityOfPage: new URL(canonicalPath, Astro.site).toString(),
  },
] : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  image={image ? new URL(image, Astro.site).toString() : undefined}
  imageAlt={casino ? `${casino.name.trim()} in ${casino.city_name}, ${casino.country_name}` : undefined}
  noindex={!casino}
  structuredData={structuredData}
  cacheSeconds={3600}
>
  {casino ? <>
    <section class="detail-hero">
      <div class="container">
        <div class="breadcrumbs"><a href="/casinos">Casino directory</a><span>/</span><a href={`/${casino.country_slug}`}>{casino.country_name}</a><span>/</span><a href={`/${casino.country_slug}/${casino.city_slug}`}>{casino.city_name}</a><span>/</span><span>{casino.name.trim()}</span></div>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{casino.short_description || 'Land-based casino'}</p>
            <h1>{casino.name.trim()}</h1>
            <p class="intro">{heroIntro || neutralIntro}</p>
            <div class="place"><span>{casino.city_name}</span>{casino.state_name && <span>{casino.state_name}</span>}<strong>{casino.country_name}</strong></div>
          </div>
          <figure class="hero-image">
            {image ? <img src={image} srcset={`${imageMedium} 760w, ${image} 1200w`} sizes="(max-width: 760px) 100vw, 46vw" width="1200" height="800" alt={`${casino.name.trim()} in ${casino.city_name}`} /> : <div class="place-mark" aria-hidden="true">{casino.name.trim().charAt(0)}</div>}
            <figcaption>{casino.city_name} · {casino.country_name}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section container detail-grid">
      <article class="editorial-copy">
        <p class="eyebrow">The full story</p>
        <h2>{casino.editorial_title || `Discover ${casino.name.trim()}`}</h2>
        {paragraphs.length ? paragraphs.map((paragraph) => <p>{paragraph}</p>) : <p class="lede">The complete editorial profile is being restored.</p>}

        {(gamesDescription || funFacts) && <div class="story-highlights">
          {gamesDescription && <section><span>01</span><div><h3>Games</h3><p>{gamesDescription}</p></div></section>}
          {funFacts && <section><span>02</span><div><h3>Fun facts</h3><p>{funFacts}</p></div></section>}
        </div>}
      </article>

      <aside class="detail-aside">
        <div class="facts card">
          <h2>Key facts</h2>
          {facts.length ? facts.map((fact) => <div><span>{fact.label}</span><strong>{fact.value}</strong></div>) : <p class="muted">Detailed facts are being verified.</p>}
          {casino.verified_operator_name && <div><span>Operator · cross-checked</span><strong>{casino.verified_operator_name}</strong></div>}
        </div>
        <div class="features card">
          <h2>Available here</h2>
          <div>{[casino.has_slots && 'Slot machines', casino.has_table_games && 'Table games', casino.has_sportsbook && 'Sportsbook', casino.has_bingo && 'Bingo', casino.always_open && 'Listed as always open'].filter(Boolean).map((item) => <span>✓ {item}</span>)}</div>
        </div>
        {(casino.street_address || casino.phone || officialWebsiteUrl) && <div class="planning card">
          <h2>Plan your visit</h2>
          {casino.street_address && <p>{casino.street_address}<br />{casino.city_name}, {casino.country_name}</p>}
          <div class="planning-links">
            {casino.phone && <a href={`tel:${casino.phone.replace(/[^+0-9,;]/g, '')}`}>{casino.phone}</a>}
            {officialWebsiteUrl && <a href={officialWebsiteUrl} target="_blank" rel="noopener nofollow">Official website ↗</a>}
          </div>
        </div>}
        {lastVerifiedLabel && sourceUrls.length > 0 && <div class="verification card">
          <p class="eyebrow">Data trail</p>
          <h2>Cross-checked {lastVerifiedLabel}</h2>
          <p>Open-data matches are accepted only when the venue name and coordinates meet strict confidence thresholds.</p>
          <div>{sourceUrls.map((source, index) => <a href={source} target="_blank" rel="noopener">Source {index + 1} ↗</a>)}</div>
        </div>}
      </aside>
    </section>

    {casino.latitude != null && casino.longitude != null && <section class="container location-panel"><div><p class="eyebrow">Location</p><h2>{casino.city_name}, {casino.country_name}</h2><p>Open the exact position in OpenStreetMap before planning your visit.</p></div><a class="button dark" href={`https://www.openstreetmap.org/?mlat=${casino.latitude}&mlon=${casino.longitude}#map=15/${casino.latitude}/${casino.longitude}`} target="_blank" rel="noopener">Open map</a></section>}
    {relatedCasinos.length ? <section class="related-section">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Continue exploring</p><h2>More casinos in<br />{casino.city_name}.</h2></div><a class="button secondary" href={`/${casino.country_slug}/${casino.city_slug}`}>View the complete city guide</a></div>
        <div class="related-grid">{relatedCasinos.map((related) => <CasinoCard casino={related} />)}</div>
      </div>
    </section> : null}
  </> : <section class="section container"><div class="empty-state"><h1>Casino not found</h1><p>The requested listing is unavailable or has moved.</p><a href="/search" class="button">Search the directory</a></div></section>}
</BaseLayout>

<style>
  .detail-hero { padding: 24px 0 72px; overflow: hidden; background: var(--forest); color: #fff; }
  .detail-hero .breadcrumbs, .detail-hero .eyebrow { color: var(--lime); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(380px, .86fr); align-items: center; gap: 62px; }
  .detail-hero h1 { max-width: 760px; margin-bottom: 23px; }
  .intro { max-width: 710px; color: #c3d3ce; font-size: 1.12rem; }
  .place { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .place span, .place strong { padding: 8px 11px; border-radius: 999px; background: rgba(255,255,255,.09); font-size: .8rem; }
  .hero-image { position: relative; overflow: hidden; aspect-ratio: 3 / 2; margin: 0; border-radius: 24px; background: #285d51; box-shadow: 0 28px 70px rgba(0,0,0,.3); }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; }
  .hero-image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(6,27,22,.55), transparent 50%); pointer-events: none; }
  .hero-image figcaption { position: absolute; z-index: 1; right: 18px; bottom: 16px; color: #fff; font-size: .75rem; }
  .place-mark { width: 100%; height: 100%; display: grid; place-items: center; color: var(--lime); font: 800 8rem/1 'Manrope', sans-serif; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, .42fr); align-items: start; gap: 70px; }
  .editorial-copy h2 { margin-bottom: 32px; }
  .editorial-copy > p:not(.eyebrow) { max-width: 790px; color: #35413e; font-size: 1.05rem; line-height: 1.82; }
  .editorial-copy > p + p { margin-top: 22px; }
  .detail-aside { position: sticky; top: 95px; display: grid; gap: 18px; }
  .facts, .features, .planning, .verification { padding: 28px; }
  .facts h2, .features h2, .planning h2, .verification h2 { margin-bottom: 18px; font-size: 1.35rem; }
  .facts > div { display: flex; justify-content: space-between; gap: 20px; padding: 15px 0; border-top: 1px solid var(--line); }
  .facts span { color: var(--muted); font-size: .84rem; }
  .facts strong { max-width: 190px; text-align: right; font-size: .9rem; }
  .features > div { display: flex; flex-wrap: wrap; gap: 8px; }
  .features span { padding: 8px 10px; border-radius: 999px; background: #e7edd0; color: #354b37; font-size: .78rem; font-weight: 600; }
  .planning p, .verification p { color: var(--muted); font-size: .88rem; line-height: 1.65; }
  .planning-links, .verification > div { display: grid; gap: 8px; margin-top: 16px; }
  .planning a, .verification a { width: fit-content; color: var(--brand-dark); font-size: .84rem; font-weight: 750; text-decoration: underline; text-underline-offset: 3px; }
  .verification { border-color: #bfd0b7; background: #f4f7e9; }
  .verification .eyebrow { margin-bottom: 8px; }
  .story-highlights { margin-top: 52px; border-top: 1px solid var(--line); }
  .story-highlights section { padding: 28px 0; display: grid; grid-template-columns: 42px 1fr; gap: 18px; border-bottom: 1px solid var(--line); }
  .story-highlights section > span { color: var(--brand-dark); font-size: .75rem; font-weight: 800; }
  .story-highlights h3 { margin-bottom: 8px; }
  .story-highlights p { margin: 0; color: var(--muted); }
  .location-panel { margin-bottom: 90px; padding: 36px; display: flex; align-items: center; justify-content: space-between; gap: 30px; border-radius: var(--radius-lg); background: var(--lime); }
  .location-panel h2, .location-panel p { margin-bottom: 0; }
  .related-section { padding: 88px 0; background: #eceae1; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; }.hero-image { max-width: 720px; }.detail-grid { grid-template-columns: 1fr; gap: 42px; }.detail-aside { position: static; grid-template-columns: repeat(2, 1fr); }.related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .detail-hero { padding-bottom: 45px; }.hero-image { border-radius: 18px; }.detail-aside, .related-grid { grid-template-columns: 1fr; }.location-panel { align-items: start; flex-direction: column; } }
</style>
