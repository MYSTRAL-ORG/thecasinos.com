---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Administration" description="Secure editorial administration for TheCasinos.com." noindex>
  <section class="admin-shell">
    <div class="container admin-heading">
      <div><p class="eyebrow">Private area</p><h1>Top 10 control room.</h1><p>Publish, edit and reorder online casinos. Supabase RLS remains the source of truth for every change.</p></div>
      <button id="logout" class="button secondary" type="button" hidden>Sign out</button>
    </div>

    <div class="container">
      <div id="config-warning" class="notice warning" hidden><strong>Supabase is not configured.</strong><span>Add the public URL and anonymous key to run authentication. Never add the service role key to Netlify’s public variables.</span></div>
      <form id="login-form" class="login-card card">
        <p class="eyebrow">Editor login</p><h2>Access administration</h2>
        <label>Email<input name="email" type="email" autocomplete="username" required /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
        <button class="button" type="submit">Sign in</button>
        <p id="login-status" class="form-status" aria-live="polite"></p>
      </form>

      <div id="admin-app" hidden>
        <div class="toolbar card">
          <div><strong>Published ranking</strong><span>Maximum 10 active positions, numbered 1 to 10.</span></div>
          <div><button id="add-casino" class="button secondary small" type="button">Add operator</button><button id="save-ranking" class="button small" type="button">Save changes</button></div>
        </div>
        <p id="admin-status" class="form-status" aria-live="polite"></p>
        <div id="online-editor" class="online-editor"></div>
      </div>
    </div>
  </section>

  <template id="operator-template">
    <article class="operator-editor card">
      <div class="editor-title"><span class="drag-mark" aria-hidden="true">↕</span><strong class="operator-name">New operator</strong><div class="row-actions"><button class="move-up" type="button" title="Move up">↑</button><button class="move-down" type="button" title="Move down">↓</button><button class="remove" type="button" title="Delete">Delete</button></div></div>
      <div class="editor-grid">
        <label class="short">Position<input data-field="position" type="number" min="1" max="10" /></label>
        <label>Name<input data-field="name" type="text" required /></label>
        <label>Legacy URL slug<input data-field="slug" type="text" required /></label>
        <label class="short">Rating / 5<input data-field="rating" type="number" min="0" max="5" step="0.1" /></label>
        <label class="wide">Bonus headline<input data-field="bonus" type="text" /></label>
        <label class="wide">Affiliate URL<input data-field="affiliate_url" type="url" /></label>
        <label class="wide">Subtitle<input data-field="subtitle" type="text" /></label>
        <label class="wide">Summary<textarea data-field="summary" rows="2"></textarea></label>
        <label class="wide">Full description<textarea data-field="description" rows="3"></textarea></label>
        <label>Key features <small>one per line</small><textarea data-field="key_features" rows="4"></textarea></label>
        <label>Pros <small>one per line</small><textarea data-field="pros" rows="4"></textarea></label>
        <label>Cons <small>one per line</small><textarea data-field="cons" rows="4"></textarea></label>
        <label>Deposit methods <small>one per line</small><textarea data-field="deposit_methods" rows="4"></textarea></label>
        <label class="wide">Online logo URL<input data-field="logo_url" type="url" /></label>
        <div class="checks wide"><label><input data-field="active" type="checkbox" /> Active in ranking</label><label><input data-field="published" type="checkbox" /> Public review</label></div>
      </div>
    </article>
  </template>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  type RecordValue = string | number | boolean | string[] | null;
  type Operator = Record<string, RecordValue> & { id?: string };
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const warning = document.querySelector<HTMLElement>('#config-warning');
  const loginForm = document.querySelector<HTMLFormElement>('#login-form');
  const loginStatus = document.querySelector<HTMLElement>('#login-status');
  const adminStatus = document.querySelector<HTMLElement>('#admin-status');
  const app = document.querySelector<HTMLElement>('#admin-app');
  const editor = document.querySelector<HTMLElement>('#online-editor');
  const template = document.querySelector<HTMLTemplateElement>('#operator-template');
  const logout = document.querySelector<HTMLButtonElement>('#logout');
  const saveButton = document.querySelector<HTMLButtonElement>('#save-ranking');
  const addButton = document.querySelector<HTMLButtonElement>('#add-casino');
  const arrayFields = new Set(['key_features', 'pros', 'cons', 'deposit_methods', 'contact_methods']);
  const booleanFields = new Set(['active', 'published']);
  const numericFields = new Set(['position', 'rating']);

  if (!supabaseUrl || !supabaseKey) {
    if (warning) warning.hidden = false;
    loginForm?.querySelectorAll('input,button').forEach((control) => (control as HTMLInputElement).disabled = true);
  } else {
    const client = createClient(supabaseUrl, supabaseKey, { auth: { persistSession: true, autoRefreshToken: true } });

    async function openAdmin() {
      const { data: { user } } = await client.auth.getUser();
      if (!user) return;
      if (user.app_metadata?.role !== 'admin') {
        await client.auth.signOut();
        setStatus(loginStatus, 'This account does not have the admin role.', true);
        return;
      }
      if (loginForm) loginForm.hidden = true;
      if (app) app.hidden = false;
      if (logout) logout.hidden = false;
      await loadOperators();
    }

    async function loadOperators() {
      setStatus(adminStatus, 'Loading ranking…');
      const { data, error } = await client.from('online_casinos').select('*').order('position', { ascending: true, nullsFirst: false }).order('name');
      if (error) return setStatus(adminStatus, error.message, true);
      if (editor) editor.replaceChildren();
      data?.forEach((operator) => renderOperator(operator));
      setStatus(adminStatus, `${data?.length ?? 0} operator${data?.length === 1 ? '' : 's'} loaded.`);
    }

    function renderOperator(operator: Operator = {}) {
      if (!template || !editor) return;
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const row = fragment.querySelector<HTMLElement>('.operator-editor');
      if (!row) return;
      row.dataset.id = operator.id ?? `new-${crypto.randomUUID()}`;
      row.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field]').forEach((control) => {
        const field = control.dataset.field!;
        const value = operator[field];
        if (control instanceof HTMLInputElement && control.type === 'checkbox') control.checked = Boolean(value);
        else if (arrayFields.has(field)) control.value = Array.isArray(value) ? value.join('\n') : '';
        else control.value = value == null ? '' : String(value);
      });
      const title = row.querySelector<HTMLElement>('.operator-name');
      if (title) title.textContent = String(operator.name ?? 'New operator');
      row.querySelector<HTMLInputElement>('[data-field="name"]')?.addEventListener('input', (event) => {
        if (title) title.textContent = (event.currentTarget as HTMLInputElement).value || 'New operator';
      });
      row.querySelector('.move-up')?.addEventListener('click', () => moveRow(row, -1));
      row.querySelector('.move-down')?.addEventListener('click', () => moveRow(row, 1));
      row.querySelector('.remove')?.addEventListener('click', () => removeRow(row));
      editor.append(fragment);
    }

    function moveRow(row: HTMLElement, direction: -1 | 1) {
      const sibling = direction < 0 ? row.previousElementSibling : row.nextElementSibling;
      if (!sibling || !editor) return;
      if (direction < 0) editor.insertBefore(row, sibling);
      else editor.insertBefore(sibling, row);
      renumberActiveRows();
    }

    function renumberActiveRows() {
      let position = 1;
      editor?.querySelectorAll<HTMLElement>('.operator-editor').forEach((row) => {
        const active = row.querySelector<HTMLInputElement>('[data-field="active"]')?.checked;
        const input = row.querySelector<HTMLInputElement>('[data-field="position"]');
        if (input && active) input.value = String(position++);
      });
    }

    async function removeRow(row: HTMLElement) {
      const id = row.dataset.id;
      if (!id?.startsWith('new-') && id && confirm('Delete this operator and its review?')) {
        const { error } = await client.from('online_casinos').delete().eq('id', id);
        if (error) return setStatus(adminStatus, error.message, true);
      } else if (!id?.startsWith('new-')) return;
      row.remove();
      renumberActiveRows();
    }

    function readRow(row: HTMLElement): Operator {
      const result: Operator = {};
      const id = row.dataset.id;
      if (id && !id.startsWith('new-')) result.id = id;
      row.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field]').forEach((control) => {
        const field = control.dataset.field!;
        if (booleanFields.has(field) && control instanceof HTMLInputElement) result[field] = control.checked;
        else if (arrayFields.has(field)) result[field] = control.value.split('\n').map((value) => value.trim()).filter(Boolean);
        else if (numericFields.has(field)) result[field] = control.value === '' ? null : Number(control.value);
        else result[field] = control.value.trim() || null;
      });
      return result;
    }

    function validate(operators: Operator[]) {
      const active = operators.filter((operator) => operator.active);
      if (active.length > 10) return 'Only 10 operators can be active in the ranking.';
      const positions = active.map((operator) => operator.position);
      if (positions.some((position) => typeof position !== 'number' || position < 1 || position > 10)) return 'Each active operator needs a position from 1 to 10.';
      if (new Set(positions).size !== positions.length) return 'Active positions must be unique.';
      if (operators.some((operator) => !operator.name || !operator.slug)) return 'Every operator needs a name and legacy URL slug.';
      return null;
    }

    async function saveRanking() {
      const rows = [...(editor?.querySelectorAll<HTMLElement>('.operator-editor') ?? [])];
      const operators = rows.map(readRow);
      const validationError = validate(operators);
      if (validationError) return setStatus(adminStatus, validationError, true);
      if (saveButton) saveButton.disabled = true;
      setStatus(adminStatus, 'Saving content and ranking…');
      const saved: Operator[] = [];
      for (const operator of operators) {
        const payload = { ...operator, position: null };
        const { data, error } = await client.from('online_casinos').upsert(payload).select().single();
        if (error) {
          if (saveButton) saveButton.disabled = false;
          return setStatus(adminStatus, error.message, true);
        }
        saved.push({ ...data, position: operator.position });
      }
      const ranking = saved.filter((operator) => operator.active).map((operator) => ({ id: operator.id, position: operator.position }));
      const { error } = await client.rpc('save_online_ranking', { ranking });
      if (saveButton) saveButton.disabled = false;
      if (error) return setStatus(adminStatus, error.message, true);
      setStatus(adminStatus, 'Ranking saved and public pages updated.');
      await loadOperators();
    }

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(loginForm);
      setStatus(loginStatus, 'Signing in…');
      const { error } = await client.auth.signInWithPassword({ email: String(formData.get('email')), password: String(formData.get('password')) });
      if (error) return setStatus(loginStatus, error.message, true);
      await openAdmin();
    });
    logout?.addEventListener('click', async () => { await client.auth.signOut(); location.reload(); });
    addButton?.addEventListener('click', () => renderOperator({ active: false, published: false, rating: 0, key_features: [], pros: [], cons: [], deposit_methods: [], contact_methods: [] }));
    saveButton?.addEventListener('click', saveRanking);
    openAdmin();
  }

  function setStatus(target: HTMLElement | null, message: string, error = false) {
    if (!target) return;
    target.textContent = message;
    target.classList.toggle('error', error);
  }
</script>

<style>
  .admin-shell { min-height: 800px; padding: 70px 0 100px; background: #eceae1; }
  .admin-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 40px; }
  .admin-heading h1 { margin-bottom: 14px; font-size: clamp(2.7rem, 6vw, 5rem); }
  .admin-heading p:last-child { max-width: 670px; color: var(--muted); }
  .notice { margin-bottom: 25px; padding: 18px; display: flex; flex-direction: column; border-radius: 12px; }
  .notice.warning { background: #fff0ca; color: #674d0b; }
  .login-card { max-width: 480px; padding: 32px; }
  .login-card h2 { font-size: 1.7rem; }
  .login-card label, .editor-grid label { display: flex; flex-direction: column; gap: 7px; color: var(--muted); font-size: .8rem; font-weight: 600; }
  .login-card input, .editor-grid input, .editor-grid textarea { width: 100%; padding: 11px 12px; border: 1px solid #cbcfc9; border-radius: 10px; outline: 0; background: #fff; color: var(--ink); font-weight: 400; }
  .login-card input:focus, .editor-grid input:focus, .editor-grid textarea:focus { border-color: var(--forest); box-shadow: 0 0 0 3px rgba(23,63,55,.1); }
  .login-card .button { margin-top: 18px; }
  .form-status { min-height: 20px; color: var(--forest); font-size: .82rem; }
  .form-status.error { color: #b1232e; }
  .toolbar { margin-bottom: 16px; padding: 20px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .toolbar > div { display: flex; flex-direction: column; gap: 3px; }
  .toolbar > div:last-child { flex-direction: row; }
  .toolbar span { color: var(--muted); font-size: .8rem; }
  .online-editor { display: grid; gap: 15px; }
  .operator-editor { overflow: hidden; }
  .editor-title { padding: 15px 18px; display: flex; align-items: center; gap: 12px; background: var(--forest); color: #fff; }
  .drag-mark { color: var(--lime); }
  .operator-name { flex: 1; }
  .row-actions { display: flex; gap: 5px; }
  .row-actions button { min-height: 32px; padding: 0 10px; border: 1px solid rgba(255,255,255,.2); border-radius: 8px; background: transparent; color: #fff; cursor: pointer; }
  .row-actions .remove { color: #ffb6bb; }
  .editor-grid { padding: 20px; display: grid; grid-template-columns: 110px repeat(3, 1fr); gap: 16px; }
  .editor-grid label.wide, .editor-grid .wide { grid-column: span 2; }
  .editor-grid label small { font-weight: 400; }
  .checks { display: flex; flex-direction: row; align-items: center; gap: 22px; }
  .checks label { flex-direction: row; align-items: center; }
  .checks input { width: 18px; height: 18px; }
  @media (max-width: 900px) { .editor-grid { grid-template-columns: repeat(2, 1fr); }.editor-grid label.short { grid-column: span 1; } }
  @media (max-width: 650px) { .admin-heading, .toolbar { align-items: start; flex-direction: column; }.editor-grid { grid-template-columns: 1fr; }.editor-grid label.wide, .editor-grid .wide { grid-column: auto; }.toolbar > div:last-child { width: 100%; flex-direction: column; }.toolbar button { width: 100%; }.row-actions .move-up, .row-actions .move-down { display: none; } }
</style>
